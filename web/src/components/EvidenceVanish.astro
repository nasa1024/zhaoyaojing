---
import { homeStrings, resolveLang } from '../i18n/home.js';
const h = homeStrings(resolveLang(Astro.url.pathname));
const v = h.vanish;
---

<section class="card content-section evidence-vanish-section" aria-labelledby="evidence-vanish-heading">
  <h2 id="evidence-vanish-heading">{v.title}</h2>
  <p class="muted">{v.subtitle}</p>

  <ol class="vanish-steps">
    {v.steps.map((step, i) => (
      <li class={`vanish-step${i === 0 ? ' vanish-step--intact' : ' vanish-step--lost'}`} data-step>
        <div class="vanish-step-header">
          <span class="vanish-step-num" aria-hidden="true">{i + 1}</span>
          <span class="vanish-step-title">{step.title}</span>
          <span
            class={`vanish-badge ${i === 0 ? 'vanish-badge--intact' : 'vanish-badge--lost'}`}
          >{i === 0 ? v.badgeIntact : v.badgeLost}</span>
        </div>
        <p class="vanish-step-detail muted">{step.detail}</p>
      </li>
    ))}
  </ol>

  <p class="vanish-emphasis"><strong>{v.emphasis}</strong></p>
</section>
