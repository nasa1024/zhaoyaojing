---
import Base from '../layouts/Base.astro';

interface Props {
  lang: 'en' | 'zh-CN';
}

const { lang } = Astro.props;
const SITE_URL = 'https://www.aicheck365.com';
const slug = 'synthid-detector';
const publishedAt = '2026-10-08';
const modifiedAt = '2026-10-08';

const articles = {
  en: {
    title: 'SynthID Detector: How Google’s AI Checker Works | AICheck365',
    description: 'Google opened SynthID Detector to everyone on October 7, 2026. What synthid.com checks, which AI companies it covers, how to read results, and its limits.',
    canonical: `${SITE_URL}/en/blog/${slug}/`,
    homeHref: '/en/',
    homeLabel: 'Home',
    blogHref: '/en/blog/',
    blogLabel: 'Blog',
    crumb: 'SynthID Detector',
    badge: 'News explainer · October 2026',
    h1: 'SynthID Detector explained: what Google’s watermark checker can and cannot tell you',
    meta: 'Published October 8, 2026 · Based on Google’s announcement, the synthid.com FAQ and terms',
    lead: 'On October 7, 2026 Google opened SynthID Detector to everyone. The portal at synthid.com checks an uploaded image, video or audio file for SynthID, the invisible watermark that Google and its partners OpenAI, NVIDIA and Kakao embed in AI-generated media, with Apple listed as coming soon. It is a strong check for that one signal and deliberately not a general AI detector. This page collects the facts, explains how to read a result, and shows where it fits next to metadata checks like the one AICheck365 runs in your browser.',
    tocLabel: 'In this article',
    toc: [
      ['#direct-answer', 'What is SynthID Detector?'],
      ['#key-facts', 'Key facts'],
      ['#how-to-use', 'How to check a file'],
      ['#results', 'How to read the result'],
      ['#comparison', 'SynthID vs metadata vs AI classifiers'],
      ['#workflow', 'Recommended workflow'],
      ['#developers', 'API and integration status'],
      ['#faq', 'FAQ'],
    ],
    directHeading: 'What is SynthID Detector?',
    directBody: 'SynthID Detector is Google DeepMind’s verification portal for SynthID watermarks. You sign in, upload a file, and it reports “watermark detected” or “watermark not detected”; for video and audio it also marks which segments carry the watermark. A detection means the file was likely generated or edited by a SynthID-enabled model. A miss proves nothing about human authorship: the file may come from a model that does not use SynthID, or the watermark may have been degraded by heavy editing.',
    factsHeading: 'Key facts as of October 2026',
    facts: [
      ['Operator', 'Google DeepMind. Announced by Pushmeet Kohli, VP of Science and Strategic Initiatives.'],
      ['Public since', 'October 7, 2026, worldwide, interface in English only. An earlier version had been limited to journalists, researchers and other waitlisted testers since May 2025.'],
      ['Address', 'synthid.com'],
      ['Companies covered', 'Google, OpenAI, NVIDIA and Kakao. Apple is listed as “soon”. Media from tools that do not embed SynthID cannot be identified.'],
      ['Images', 'JPG, JPEG, PNG, BMP, WEBP, AVIF, HEIC, HEIF, TIFF, TIF, GIF. Result: watermark present or not.'],
      ['Video', 'MP4, MOV, WEBM. Result: which segments carry the watermark.'],
      ['Audio', 'WAV, MP3, OGG, FLAC, AAC, M4A. Result: which segments carry the watermark.'],
      ['Text', 'Not accepted by the portal, although SynthID also has a text watermark.'],
      ['Account', 'Sign-in required; third-party sign-in such as Apple is supported. Daily usage quotas apply.'],
      ['Privacy', 'Uploads are processed in real time and deleted once the result is returned. A digital signature of the file is kept for 24 hours to enforce quotas.'],
      ['Scale', 'Google says SynthID has marked more than 180 billion images and videos and 240,000 years of audio, and that SynthID checks in Search, Chrome and the Gemini app handle over 1 million requests a day.'],
    ],
    useHeading: 'How to check a file with SynthID Detector',
    useSteps: [
      ['1. Find the best copy', 'Use the original download from the generator, not a screenshot, chat-app copy or re-encoded repost. Google asks for the highest-quality file you have because heavy compression and editing weaken detection.'],
      ['2. Sign in at synthid.com', 'The detector needs an account so it can apply daily quotas. Accept the additional terms only if you are fine with them.'],
      ['3. Upload one file', 'Pick an image, video or audio file in a supported format. Video and audio results are segment-based, so long files can show watermarked and clean parts side by side.'],
      ['4. Record the result with context', 'Note the date, the file you tested and where it came from. A watermark result is one data point; Google itself recommends collecting several before deciding.'],
    ],
    resultsHeading: 'How to read a SynthID Detector result',
    resultsIntro: 'The portal returns a binary answer. The wording below follows the synthid.com FAQ.',
    resultRows: [
      ['Watermark detected', 'A SynthID watermark is present. The content was likely generated or edited by a SynthID-enabled model from Google, OpenAI, NVIDIA or Kakao. It does not tell you which product, prompt or person made it, or whether only part of an image was edited.'],
      ['Watermark not detected', 'No confident signal. The file was probably not made by a SynthID-enabled model, but AI generation is not ruled out: other generators such as Midjourney or Stable Diffusion do not use SynthID, older content predates partner adoption, and heavy modification can destroy the signal.'],
      ['False positive', 'Google says that in very rare cases SynthID can trigger on content that was never watermarked. Treat a single positive as strong evidence, not as a verdict.'],
    ],
    comparisonHeading: 'SynthID vs metadata checks vs general AI detectors',
    comparisonIntro: 'These methods answer different questions. None of them covers every file, which is why they work best together.',
    comparisonColumns: ['Method', 'What it reads', 'Strength', 'Blind spot'],
    comparisonRows: [
      ['SynthID Detector (synthid.com)', 'Invisible watermark woven into pixels, video frames or audio frequencies', 'Survives filters, colour changes, lossy compression and metadata stripping', 'Only covers SynthID adopters; file must be uploaded to Google; no model or prompt details'],
      ['C2PA and metadata (AICheck365)', 'Content Credentials, digitalSourceType, EXIF, XMP, PNG parameters, MP4 fields', 'Names the tool, can carry a signature, runs locally without uploading', 'Lost after screenshots, chat-app compression or re-export'],
      ['General AI classifiers', 'Statistical artifacts in pixels or audio', 'Works when no signal was embedded', 'Probabilistic, weaker on new models and recompressed files, hard to use as proof'],
      ['Google Cloud AI Content Detection API', 'Pixel-level artifacts, noise and spectral patterns (images only)', 'Programmatic, covers Google and third-party models', 'Private Preview by application; a classifier, not a SynthID watermark lookup'],
    ],
    workflowHeading: 'Recommended workflow: metadata first, watermark second',
    workflowIntro: 'SynthID and file metadata fail in opposite situations. Metadata disappears when a file is screenshotted or recompressed, while the watermark is designed to survive exactly that. Metadata can name the tool and carry a signature; the watermark cannot. Use both:',
    workflowSteps: [
      'Run the original file through the AICheck365 detector. It reads C2PA, EXIF, XMP, PNG text chunks and MP4 metadata locally, so nothing leaves your browser.',
      'If the scan finds a Google, OpenAI, NVIDIA or Kakao signal, upload the same file to SynthID Detector to confirm the watermark is still present in this copy.',
      'If the scan finds nothing because the file was shared or screenshotted, SynthID Detector is the next best check for media that may have come from those companies.',
      'If both come back empty, the file may still be AI-generated by a tool that writes neither metadata nor SynthID. Look for the earliest source and compare other copies.',
    ],
    developersHeading: 'API and integration status',
    developersBody: [
      'synthid.com has no public API. Its additional terms forbid submitting requests programmatically, scraping, or using the frontend as an automated API, and they forbid creating extra accounts to get around quotas. Any integration has to send people to the portal rather than call it behind the scenes.',
      'For businesses, Google lists an AI Content Detection API on its Gemini Enterprise Agent Platform. According to its documentation it is in Private Preview, accepts JPEG, PNG and WebP images, and uses models that analyse pixel artifacts, noise and spectral anomalies, which makes it a classifier rather than a SynthID watermark check. Access requires an application.',
      'SynthID Text, the text variant, has been open-sourced by Google, but the Detector portal does not accept text uploads.',
    ],
    siteHeading: 'Where AICheck365 fits',
    siteBody: 'AICheck365 does not read SynthID. The watermark’s decoder is proprietary, and we do not upload files. What we read is the provenance data that travels in the file itself, including C2PA manifests that sometimes state SynthID was applied. That statement is a claim recorded by the generator, not proof the watermark survives in your copy. When our scan is empty or points to a SynthID partner, the result page now links to SynthID Detector as the next step.',
    ctaLead: 'Check the file locally first, then decide whether a watermark check is worth an upload.',
    ctas: [
      ['/en/', 'Scan a file in your browser'],
      ['/en/blog/how-to-detect-gemini-generated-images/', 'Gemini C2PA and SynthID guide'],
      ['/en/tools/c2pa-viewer/', 'C2PA viewer'],
      ['/en/blog/how-to-detect-ai-videos/', 'How to check AI videos'],
    ],
    faqHeading: 'Frequently asked questions',
    faq: [
      ['Is SynthID Detector free?', 'Google does not list a price. You need to sign in, and daily usage quotas apply.'],
      ['Can SynthID Detector tell if an image is from ChatGPT?', 'Only if the image carries a SynthID watermark. OpenAI is listed as a SynthID adopter, so images from OpenAI products that embed it can be detected; images made before adoption, or by other tools, will show as not detected.'],
      ['Can it detect Midjourney or Stable Diffusion images?', 'No. Those tools are not SynthID partners. Check the file’s metadata instead, for example PNG generation parameters or C2PA, with a metadata reader such as AICheck365.'],
      ['Does “watermark not detected” mean a human made it?', 'No. It only means no confident SynthID signal was found. The file may be from a non-partner model, from before adoption, or heavily modified.'],
      ['Does SynthID survive screenshots and compression?', 'It is designed to survive filters, colour changes and lossy compression, which usually strip metadata. Google warns that it is not infallible and that many combined transformations can remove it.'],
      ['Does Google keep the files I upload?', 'According to the synthid.com privacy notice, files are deleted once the result is returned. A digital signature of the file is kept for 24 hours to enforce quotas and is then deleted.'],
      ['Can SynthID Detector check text?', 'Not at the moment. The portal accepts images, video and audio. SynthID also has a text watermark, but text checking is not offered on synthid.com.'],
      ['Is there a SynthID Detector API?', 'Not for the portal, and its terms forbid automating it. Google’s separate AI Content Detection API for businesses is in Private Preview and is an image classifier rather than a watermark lookup.'],
    ],
    sourcesHeading: 'Sources',
    sources: [
      ['https://blog.google/innovation-and-ai/models-and-research/google-deepmind/synth-id-ai-content/', 'Google: We’re making it easier to identify AI-generated content globally (Oct 7, 2026)', 'Public launch, partners, scale figures.'],
      ['https://synthid.com/', 'SynthID Detector', 'Supported formats, FAQ, additional terms and privacy notice.'],
      ['https://blog.google/innovation-and-ai/products/google-synthid-ai-content-detector/', 'Google: SynthID Detector early access (May 20, 2025)', 'Original announcement for early testers.'],
      ['https://docs.cloud.google.com/gemini-enterprise-agent-platform/models/ai-content-detection', 'Google Cloud: Detect AI-generated images', 'AI Content Detection API, Private Preview.'],
      ['https://deepmind.google/models/synthid/', 'Google DeepMind: SynthID', 'Overview of watermarking for image, audio, text and video.'],
    ],
    back: 'Back to the blog',
  },
  'zh-CN': {
    title: 'SynthID Detector 是什么？Google AI 水印检测怎么用 | AICheck365',
    description: 'Google 于 2026 年 10 月 7 日向所有人开放 SynthID Detector。本文说明 synthid.com 能查什么、覆盖哪些 AI 公司、结果怎么看，以及它的局限。',
    canonical: `${SITE_URL}/blog/${slug}/`,
    homeHref: '/',
    homeLabel: '首页',
    blogHref: '/blog/',
    blogLabel: '知识库',
    crumb: 'SynthID Detector',
    badge: '新闻解读 · 2026 年 10 月',
    h1: 'SynthID Detector 详解：Google 的 AI 水印检测能证明什么，不能证明什么',
    meta: '2026年10月8日发布 · 依据 Google 公告、synthid.com FAQ 与使用条款整理',
    lead: '2026 年 10 月 7 日，Google 把 SynthID Detector 开放给所有人。用户在 synthid.com 上传图片、视频或音频，它会检查文件里有没有 SynthID：Google 及合作方 OpenAI、NVIDIA、Kakao 在 AI 生成内容里嵌入的隐形水印，Apple 标注为“即将加入”。它查这一种信号很可靠，但官方明说它不是通用 AI 检测器。本文整理已确认的事实、结果的读法，以及它和 AICheck365 这类本地元数据检测怎么配合。',
    tocLabel: '本文目录',
    toc: [
      ['#direct-answer', 'SynthID Detector 是什么'],
      ['#key-facts', '关键信息'],
      ['#how-to-use', '怎么检测一个文件'],
