    ],
    sourcesHeading: '参考来源',
    sources: [
      ['https://blog.google/innovation-and-ai/models-and-research/google-deepmind/synth-id-ai-content/', 'Google：We’re making it easier to identify AI-generated content globally（2026-10-07）', '全球开放、合作方、规模数据。'],
      ['https://synthid.com/', 'SynthID Detector', '支持格式、FAQ、附加条款与隐私说明。'],
      ['https://blog.google/innovation-and-ai/products/google-synthid-ai-content-detector/', 'Google：SynthID Detector 早期测试（2025-05-20）', '最初面向早期测试者的公告。'],
      ['https://docs.cloud.google.com/gemini-enterprise-agent-platform/models/ai-content-detection', 'Google Cloud：Detect AI-generated images', 'AI Content Detection API，Private Preview。'],
      ['https://deepmind.google/models/synthid/', 'Google DeepMind：SynthID', '图片、音频、文本、视频水印概览。'],
    ],
    back: '返回知识库',
  },
};

const c = articles[lang];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: c.homeLabel, item: `${SITE_URL}${c.homeHref}` },
      { '@type': 'ListItem', position: 2, name: c.blogLabel, item: `${SITE_URL}${c.blogHref}` },
      { '@type': 'ListItem', position: 3, name: c.crumb, item: c.canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: c.h1,
    name: c.h1,
    description: c.description,
    url: c.canonical,
    mainEntityOfPage: c.canonical,
    inLanguage: lang,
    datePublished: publishedAt,
    dateModified: modifiedAt,
    isAccessibleForFree: true,
    author: { '@type': 'Organization', name: 'AICheck365', url: SITE_URL },
    publisher: { '@type': 'Organization', name: 'AICheck365', url: SITE_URL },
    citation: c.sources.map(([href]) => href),
    keywords: lang === 'en'
      ? ['SynthID Detector', 'SynthID', 'Google AI watermark detector', 'synthid.com', 'AI image watermark', 'C2PA']
      : ['SynthID Detector', 'SynthID 检测', 'Google AI 水印检测', 'synthid.com', 'AI 图片水印', 'C2PA'],
    about: [
      { '@type': 'SoftwareApplication', name: 'SynthID Detector', url: 'https://synthid.com/', applicationCategory: 'UtilitiesApplication', operatingSystem: 'Web' },
      { '@type': 'Thing', name: 'SynthID' },
      { '@type': 'Thing', name: 'C2PA Content Credentials' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: c.faq.map(([question, answer]) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  },
];
---

<Base
  title={c.title}
  description={c.description}
  canonical={c.canonical}
  lang={lang}
  alternateLangs={['zh-CN', 'en']}
  jsonLd={jsonLd}
>
  <main class="page content-page synthid-article">
    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href={c.homeHref}>{c.homeLabel}</a> › <a href={c.blogHref}>{c.blogLabel}</a> › {c.crumb}
    </nav>

    <article class="card content-article priority-seo-page" data-priority-page={`blog/${slug}`}>
      <div class="article-kicker">{c.badge}</div>
      <h1>{c.h1}</h1>
      <p class="article-meta">{c.meta}</p>
      <p class="lead-text">{c.lead}</p>

      <nav class="article-toc" aria-label={c.tocLabel}>
        <strong>{c.tocLabel}</strong>
        <div class="article-toc-links">
          {c.toc.map(([href, label]) => <a href={href}>{label}</a>)}
        </div>
      </nav>

      <section class="priority-direct-answer" id="direct-answer">
        <h2>{c.directHeading}</h2>
        <p>{c.directBody}</p>
      </section>

      <section id="key-facts">
        <h2>{c.factsHeading}</h2>
        <div class="table-scroll">
          <table class="tool-glossary evidence-table">
            <tbody>
              {c.facts.map(([label, detail]) => <tr><th>{label}</th><td>{detail}</td></tr>)}
            </tbody>
          </table>
        </div>
      </section>

      <section id="how-to-use">
        <h2>{c.useHeading}</h2>
        <div class="mechanism-grid">
          {c.useSteps.map(([heading, detail]) => (
            <div class="mechanism-card">
              <h3>{heading}</h3>
              <p>{detail}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="results">
        <h2>{c.resultsHeading}</h2>
        <p>{c.resultsIntro}</p>
        <div class="table-scroll">
          <table class="tool-glossary evidence-table">
            <tbody>
              {c.resultRows.map(([label, detail]) => <tr><th>{label}</th><td>{detail}</td></tr>)}
            </tbody>
          </table>
        </div>
      </section>

      <section id="comparison">
        <h2>{c.comparisonHeading}</h2>
        <p>{c.comparisonIntro}</p>
        <div class="table-scroll">
          <table class="tool-glossary comparison-table">
            <thead>
              <tr>{c.comparisonColumns.map((column) => <th>{column}</th>)}</tr>
            </thead>
            <tbody>
              {c.comparisonRows.map((row) => (
                <tr>{row.map((cell, index) => index === 0 ? <th>{cell}</th> : <td>{cell}</td>)}</tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="workflow">
        <h2>{c.workflowHeading}</h2>
        <p>{c.workflowIntro}</p>
        <ol class="content-list">
          {c.workflowSteps.map((item) => <li>{item}</li>)}
        </ol>
      </section>

      <section id="developers">
        <h2>{c.developersHeading}</h2>
        {c.developersBody.map((paragraph) => <p>{paragraph}</p>)}
      </section>

      <section id="aicheck365-position">
        <h2>{c.siteHeading}</h2>
        <p>{c.siteBody}</p>
        <div class="cta-box">
          <p>{c.ctaLead}</p>
          <div class="related-links">
            {c.ctas.map(([href, label]) => <a href={href}>{label} →</a>)}
            <a href="https://synthid.com/" target="_blank" rel="noopener">SynthID Detector ↗</a>
          </div>
        </div>
      </section>

      <section id="faq">
        <h2>{c.faqHeading}</h2>
        <div class="faq-list">
          {c.faq.map(([question, answer]) => (
            <details class="faq-item">
              <summary>{question}</summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section id="sources">
        <h2>{c.sourcesHeading}</h2>
        <ol class="content-list source-list">
          {c.sources.map(([href, label, note]) => (
            <li><a href={href} target="_blank" rel="noopener">{label}</a> — {note}</li>
          ))}
        </ol>
      </section>

      <p class="article-back"><a href={c.blogHref}>← {c.back}</a></p>
    </article>
  </main>

  <script is:inline>
    (() => {
      const supportedArticleLangs = new Set(['en', 'zh-CN']);
      const select = document.getElementById('lang-switch');
      select?.addEventListener('change', (event) => {
        const value = event.target?.value;
        if (!value || supportedArticleLangs.has(value)) return;
        event.stopImmediatePropagation();
        window.location.assign(`/${value}/`);
      }, true);
    })();
  </script>
</Base>

<style>
  .synthid-article { max-width: 1120px; }
  .article-kicker {
    display: inline-flex;
    margin-bottom: 12px;
    padding: 6px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: .82rem;
    font-weight: 700;
    letter-spacing: .02em;
    color: var(--text-muted);
  }
  .article-toc {
    margin: 24px 0 32px;
    padding: 18px 20px;
    border: 1px solid var(--border);
    border-radius: 14px;
  }
  .article-toc-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: 10px;
  }
  .article-toc-links a { font-size: .92rem; }
  .mechanism-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin: 1.25rem 0;
  }
  .mechanism-card {
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface-2);
  }
  .mechanism-card h3 { margin: 0 0 8px; }
  .mechanism-card p { margin: 0; }
  .table-scroll { overflow-x: auto; margin: 1rem 0 1.5rem; }
  .comparison-table { min-width: 860px; }
  .comparison-table thead th { white-space: nowrap; }
  .comparison-table tbody th { min-width: 190px; }
  .evidence-table th { min-width: 150px; }
  .article-back { margin-top: 2rem; }
  .source-list a { overflow-wrap: anywhere; }
  @media (max-width: 760px) {
    .mechanism-grid { grid-template-columns: 1fr; }
  }
</style>
