---
import experiments from '../../public/data/experiments.json';
import { homeStrings, resolveLang } from '../i18n/home.js';
const h = homeStrings(resolveLang(Astro.url.pathname)).experiments;
---

<section class="latest-experiments card content-section" id="latest-experiments">
  <h2>{h.title}</h2>
  {experiments.length > 0 && <p class="muted compact">{h.subtitle}</p>}
  {experiments.length === 0 ? (
    <p class="muted experiment-placeholder">{h.soon}</p>
  ) : (
    <div class="experiment-cards">
      {experiments.map((e: any) => (
        <article class="experiment-card card">
          <div class="experiment-card-header">
            <strong>{e.platform}</strong>
            {e.testDate && <span class="muted">{e.testDate}</span>}
          </div>
          <div class="experiment-meta">
            <span>{e.fileFormat}</span>
            <span>{e.sampleCount} {h.samples}</span>
            {e.resultChanged && <span class="badge medium">{h.changed}</span>}
          </div>
          <p class="experiment-findings">{e.mainFindings}</p>
          {e.parserVersion && (
            <p class="muted experiment-parser">{h.parser}: {e.parserVersion}</p>
          )}
          {(e.researchUrl || e.detailUrl) && (
            <a
              href={e.researchUrl || e.detailUrl}
              class="experiment-link"
              rel={e.researchUrl ? undefined : 'noopener'}
              target={e.researchUrl ? undefined : '_blank'}
            >
              {h.detail} →
            </a>
          )}
        </article>
      ))}
    </div>
  )}
</section>
