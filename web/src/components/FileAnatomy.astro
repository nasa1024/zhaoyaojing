---
import { homeStrings, resolveLang } from '../i18n/home.js';
const h = homeStrings(resolveLang(Astro.url.pathname));

const layers = [
  'sample.png',
  '├── PNG Header',
  '├── C2PA Manifest',
  '├── XMP CreatorTool',
  '├── digitalSourceType',
  '├── claim_generator',
  '└── Embedded Parameters',
];
---
<figure class="file-anatomy" aria-label="File structure anatomy example">
  <pre class="mono anatomy-tree">{layers.map((l, i) => <span class="anatomy-line" style={`--i:${i}`}>{l}</span>)}</pre>
  <figcaption class="muted">{h.anatomy.caption}</figcaption>
</figure>
