---
import { homeStrings, resolveLang } from '../i18n/home.js';

interface Props {
  prefix: string;
}
const { prefix } = Astro.props;
const h = homeStrings(resolveLang(Astro.url.pathname));

const platforms = [
  { name: 'OpenAI / DALL-E', slug: 'dall-e' },
  { name: 'Gemini', slug: 'gemini' },
  { name: 'Midjourney', slug: 'midjourney' },
  { name: 'Adobe Firefly', slug: 'firefly' },
  { name: 'Stable Diffusion', slug: 'stable-diffusion' },
  { name: 'ComfyUI', slug: 'comfyui' },
  { name: 'Sora', slug: 'sora' },
  { name: 'Kling', slug: 'kling' },
  { name: 'Runway', slug: 'runway' },
  { name: 'Flux', slug: 'flux' },
];
---

<section class="card content-section platform-fingerprint" aria-labelledby="platform-fingerprint-heading">
  <h2 id="platform-fingerprint-heading">{h.platforms.title}</h2>
  <p class="muted">{h.platforms.subtitle}</p>

  <nav class="platform-capsule-row" aria-label={h.platforms.title}>
    {platforms.map((p) => (
      <a
        class="platform-capsule"
        href={`${prefix}/platforms/${p.slug}/`}
        lang="en"
      >
        {p.name}
      </a>
    ))}
  </nav>
</section>
