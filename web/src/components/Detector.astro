detectorCopy['zh-TW'] = {
  ...detectorCopy['zh-CN'],
  uploadTitle: '上傳圖片/影片',
  uploadSubtitle: '選擇圖片或影片後點擊檢測。所有分析都在本機完成。',
  aria: '點擊選擇圖片或影片',
  zoneTitle: '點擊或拖曳圖片/影片到此處',
  button: '開始檢測',
  init: '正在初始化…',
  platformsTitle: '可識別的平台 / 工具',
  platformsDesc: '這裡只代表<strong>目前可識別的來源痕跡範圍</strong>，不代表支援所有 AI 圖片/影片平台。',
  signals: '支援的信號類型',
  formatsTitle: '支援格式',
  results: '檢測結果',
  empty: '選一個原始檔案試試。越原始的檔案，越容易保留可檢測的來源信號。',
  history: '最近檢測',
};
const copy = detectorCopy[lang] ?? detectorCopy.en;

// §19: no-JS fallback notice for the interactive detector
const NOSCRIPT = {
  'zh-CN': '检测器需要 JavaScript 才能在本地分析文件。即使未启用 JavaScript，下方的方法论、支持格式和平台指南依然可以阅读。',
  'zh-TW': '偵測器需要 JavaScript 才能在本機分析檔案。即使未啟用 JavaScript，下方的方法論、支援格式和平台指南依然可以閱讀。',
  en: 'The detector needs JavaScript to analyze files locally. Even without JavaScript, the methodology, supported formats, and platform guides below remain readable.',
  ja: '検出器はファイルをローカルで分析するために JavaScript が必要です。JavaScript が無効でも、下記の方法論・対応フォーマット・プラットフォームガイドは読めます。',
  ko: '검사기는 파일을 로컬에서 분석하려면 JavaScript가 필요합니다. JavaScript가 없어도 아래의 방법론, 지원 형식, 플랫폼 가이드는 읽을 수 있습니다.',
  de: 'Der Detektor benötigt JavaScript, um Dateien lokal zu analysieren. Auch ohne JavaScript bleiben Methodik, unterstützte Formate und Plattform-Guides unten lesbar.',
  fr: 'Le détecteur a besoin de JavaScript pour analyser les fichiers localement. Sans JavaScript, la méthodologie, les formats pris en charge et les guides de plateformes ci-dessous restent lisibles.',
  es: 'El detector necesita JavaScript para analizar archivos localmente. Incluso sin JavaScript, la metodología, los formatos compatibles y las guías de plataformas siguen siendo legibles.',
  'pt-BR': 'O detector precisa de JavaScript para analisar arquivos localmente. Mesmo sem JavaScript, a metodologia, os formatos suportados e os guias de plataformas continuam legíveis.',
};
const noscriptCopy = NOSCRIPT[lang] ?? NOSCRIPT.en;

// §16: ad slots must be clearly labeled
const AD_LABEL = { 'zh-CN': '广告', 'zh-TW': '廣告', en: 'Advertisement', ja: '広告', ko: '광고', de: 'Anzeige', fr: 'Publicité', es: 'Publicidad', 'pt-BR': 'Publicidade' };
const adLabel = AD_LABEL[lang] ?? AD_LABEL.en;
const EXPERT_LABEL = {
  'zh-CN': '专家模式',
  'zh-TW': '專家模式',
  en: 'Expert mode',
  ja: 'エキスパートモード',
  ko: '전문가 모드',
  de: 'Expertenmodus',
  fr: 'Mode expert',
  es: 'Modo experto',
  'pt-BR': 'Modo especialista',
};
const expertLabel = EXPERT_LABEL[lang] ?? EXPERT_LABEL.en;
const isChineseLocale = lang === 'zh-CN' || lang === 'zh-TW';
const platformNames = [
  'Adobe Firefly',
  'Automatic1111 / A1111',
  'Bing Image Creator',
  'Canva AI',
  'ComfyUI',
  'Copilot Designer',
  'Craiyon',
  'DALL-E / OpenAI',
  'DeepAI',
  'DreamStudio',
  'Flux',
  'Fooocus',
  'Genmo',
  'Google Veo',
  'Grok',
  isChineseLocale ? 'Hailuo / 海螺' : 'Hailuo',
  'Haiper',
  'Ideogram',
  'Imagen / Google AI / Gemini',
  'InvokeAI',
  isChineseLocale ? 'Jimeng / 即梦 / Dreamina' : 'Jimeng / Dreamina',
  'Kling',
  'Leonardo.ai',
  'Luma',
  'Meta AI',
  'Microsoft Designer',
  'Midjourney',
  'NightCafe',
  'NovelAI',
  'Pika',
  'Pixverse',
  isChineseLocale ? 'Qwen / 通义万相' : 'Qwen Image',
  'Recraft',
  'Runway',
  'Seedream',
  'Sora',
  'Stability AI',
  'Stable Diffusion',
  'Vidu',
  'Wan',
];
---

<section class="grid two-col primary-grid">
  <div class="card upload-card">
    <h2 data-i18n="upload.title">{copy.uploadTitle}</h2>
    <p class="muted compact" data-i18n="upload.subtitle">{copy.uploadSubtitle}</p>
    <label class="upload" for="file-input" id="upload-zone">
      <input id="file-input" type="file" multiple accept="image/jpeg,image/png,image/webp,image/gif,image/bmp,image/tiff,video/mp4,video/quicktime,video/webm,video/x-msvideo,.mp4,.mov,.m4v,.webm,.avi" aria-label={copy.aria} />
      <span class="upload-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 15V4" />
          <path d="m7.5 8.5 4.5-4.5 4.5 4.5" />
          <path d="M4 15v3.5A2.5 2.5 0 0 0 6.5 21h11a2.5 2.5 0 0 0 2.5-2.5V15" />
        </svg>
      </span>
      <span class="upload-title" data-i18n="upload.zone.title">{copy.zoneTitle}</span>
      <small data-i18n="upload.zone.formats">{copy.formats}</small>
    </label>
    <div id="file-meta" class="file-meta hidden" aria-live="polite"></div>
    <button id="analyze-btn" class="primary" disabled data-i18n="upload.button">{copy.button}</button>
    <p id="status" class="status muted" role="status" aria-live="polite" data-i18n="upload.status.init">{copy.init}</p>
    <noscript>
      <p class="notice warning">{noscriptCopy}</p>
    </noscript>
  </div>

  <section class="card result-card" id="result-card">
    <div class="section-heading">
      <div>
        <h2 data-i18n="results.title">{copy.results}</h2>
        <p class="muted compact" data-i18n="results.subtitle">{copy.resultsSubtitle}</p>
      </div>
      <label class="expert-toggle"><input type="checkbox" id="expert-mode" /> <span data-i18n="result.expert">{expertLabel}</span></label>
    </div>
    <div id="empty-state" class="empty-state">
      <svg class="empty-illust" viewBox="0 0 200 140" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <rect class="ei-doc" x="46" y="18" width="86" height="104" rx="8" />
        <line class="ei-row" x1="62" y1="42" x2="116" y2="42" />
        <line class="ei-row" x1="62" y1="60" x2="104" y2="60" />
        <line class="ei-row" x1="62" y1="78" x2="112" y2="78" />
        <line class="ei-row" x1="62" y1="96" x2="92" y2="96" />
        <circle class="ei-lens" cx="122" cy="88" r="30" />
        <line class="ei-handle" x1="144" y1="110" x2="162" y2="128" />
        <path class="ei-query" d="M114 84c0-5 4-8 8-8s8 3 8 8c0 6-8 6-8 12" />
        <circle class="ei-query-dot" cx="122" cy="102" r="1.6" />
      </svg>
      <p data-i18n="results.empty">{copy.empty}</p>
    </div>
    <div id="report-skeleton" class="report-skeleton hidden" aria-hidden="true">
      <div class="sk-row sk-w40"></div>
      <div class="sk-block"></div>
      <div class="sk-row sk-w80"></div>
      <div class="sk-row sk-w60"></div>
      <div class="sk-block sk-block-sm"></div>
    </div>
    <div id="report" class="report hidden"></div>
  </section>
</section>

<section class="grid two-col">
  <div class="card">
    <h2 data-i18n="platforms.title">{copy.platformsTitle}</h2>
    <p class="muted" data-i18n-html="platforms.desc" set:html={copy.platformsDesc} />
    <ul id="platform-list" class="tag-list" aria-label={copy.platformAria}>
      {platformNames.map((name) => <li>{name}</li>)}
    </ul>
  </div>
  <div class="card">
    <h2 data-i18n="signals.title">{copy.signals}</h2>
    <ul id="signal-types" class="bullet-list">
      <li>C2PA Content Credentials / JUMBF</li>
      <li>EXIF metadata</li>
      <li>XMP / IPTC metadata</li>
      <li>PNG tEXt / iTXt chunks</li>
      <li>MP4 container metadata / AIGC labels / SEI markers</li>
      <li>Sampled video frame watermark analysis</li>
      <li>Filename heuristics</li>
    </ul>
  </div>
</section>

<section class="grid">
  <div class="card">
    <h2 data-i18n="formats.title">{copy.formatsTitle}</h2>
    <ul id="format-list" class="tag-list">
      <li>image/jpeg</li>
      <li>image/png</li>
      <li>image/webp</li>
      <li>image/gif</li>
      <li>image/bmp</li>
      <li>image/tiff</li>
      <li>video/mp4</li>
      <li>video/quicktime</li>
      <li>video/x-m4v</li>
      <li>video/webm</li>
      <li>video/x-msvideo</li>
    </ul>
  </div>
</section>

<div class="ad-slot ad-slot--horizontal" data-ad-placement="after-detector-results">
  <span class="ad-label" style="display:block;font-size:11px;text-transform:uppercase;letter-spacing:.08em;opacity:.55;margin-bottom:6px">{adLabel}</span>
  <!-- Replace after AdSense approval:
  <ins class="adsbygoogle"
       style="display:block"
       data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
       data-ad-slot="XXXXXXXXXX"
       data-ad-format="auto"
       data-full-width-responsive="true"></ins>
  <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  -->
</div>

<section class="card history-section">
  <h2 data-i18n="history.title">{copy.history}</h2>
  <p class="muted compact" data-i18n="history.subtitle">{copy.historySubtitle}</p>
  <div id="history-list" class="history-list"></div>
</section>

<!-- 检测器 JS -->
<script>
  import '../scripts/main.js';
</script>

<style>
  .upload-icon svg {
    width: 26px;
    height: 26px;
  }
  .empty-illust {
    width: 160px;
    height: auto;
    margin-bottom: 14px;
  }
  .ei-doc {
    fill: rgb(var(--overlay-rgb) / 0.04);
    stroke: var(--border-strong);
  }
  .ei-row {
    stroke: var(--muted);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 1 9;
    opacity: 0.8;
  }
  .ei-lens {
    fill: rgb(var(--accent-rgb) / 0.06);
    stroke: var(--accent);
    stroke-width: 2;
  }
  .ei-handle {
    stroke: var(--accent);
    stroke-width: 5;
    stroke-linecap: round;
  }
  .ei-query {
    fill: none;
    stroke: var(--muted);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .ei-query-dot {
    fill: var(--muted);
  }
</style>
