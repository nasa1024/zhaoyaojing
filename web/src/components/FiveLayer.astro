---
import { homeStrings, resolveLang } from '../i18n/home.js';
const h = homeStrings(resolveLang(Astro.url.pathname));

// Illustrative real-world metadata field names. These are language-neutral
// technical examples and are intentionally not translated; the layer titles
// come from the i18n dictionary.
const layerFields = [
  [
    'Format:          PNG / JPEG / WebP / MP4 / MOV',
    'FileSize:        2.4 MB',
    'ColorSpace:      sRGB',
    'BitDepth:        8',
    'ImageWidth:      1024',
    'ImageHeight:     1024',
  ],
  [
    'Software:                DALL-E 3',
    'Make:                    OpenAI',
    'XMP:CreatorTool:         Adobe Firefly',
    'XMP:DigitalSourceType:   trainedAlgorithmicMedia',
    'XMP:CreateDate:          2024:03:15 14:22:07',
    'XMP:MetadataDate:        2024:03:15 14:22:07',
  ],
  [
    'tEXt:parameters:   masterpiece, best quality, 1girl',
    'tEXt:prompt:       a futuristic city at night',
    'tEXt:negative:     lowres, bad anatomy, blurry',
    'tEXt:steps:        20',
    'tEXt:sampler:      DPM++ 2M Karras',
    'tEXt:model_hash:   d8691b4d18',
  ],
  [
    'c2pa:claim_generator:   Adobe Firefly 1.0',
    'c2pa:claim_generator_hints: adobeFirefly',
    'digitalSourceType:      trainedAlgorithmicMedia',
    'c2pa:title:             Firefly_20240315.jpg',
    'Signature:              VALID (SHA-256, RS256)',
    'Certificate:            Adobe Inc. / DigiCert',
  ],
  [
    'Handler:         kling-ai-1.6-standard',
    'Encoder:         Kling Video v1.6',
    'UserData:        {"generator":"kling","model":"v1.6"}',
    'SEI:UUID:        kling_provenance_v1',
    'FrameWatermark:  detected (confidence: 0.91)',
    'MetadataTrack:   sora_video_metadata_v1.0',
  ],
];
---

<section class="card content-section five-layer-section" aria-labelledby="five-layer-heading">
  <h2 id="five-layer-heading">{h.fiveLayer.title}</h2>
  <p class="muted">{h.fiveLayer.subtitle}</p>

  <div class="five-layer-list">
    {layerFields.map((fields, i) => (
      <details class="evidence-layer card">
        <summary class="evidence-layer-summary">
          <span class="evidence-layer-num" aria-hidden="true">{i + 1}</span>
          <span class="evidence-layer-title">{h.fiveLayer.layerTitles[i]}</span>
          <span class="evidence-layer-chevron" aria-hidden="true">›</span>
        </summary>
        <pre class="mono evidence-layer-fields">{fields.join('\n')}</pre>
      </details>
    ))}
  </div>
</section>
