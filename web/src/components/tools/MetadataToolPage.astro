      { q: '文件会上传吗？', a: '不会。解析逻辑通过 WebAssembly 在你的浏览器本地运行。' },
    ],
    related: [
      ['/tools/c2pa-validator/', 'C2PA 验证器'],
      ['/tools/png-parameter-extractor/', 'PNG 参数/工作流提取器'],
      ['/platforms/gemini/', 'Gemini / Google AI 指南'],
      ['/blog/ai-image-metadata-guide/', 'AI 图片/视频元数据指南'],
