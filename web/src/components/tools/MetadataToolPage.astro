const UI_COPY = {
  'zh-CN': {
    loading: '正在加载解析引擎…',
    analyzing: '正在分析…',
    done: '完成',
    error: '错误：',
    noFile: '请选择文件',
    empty: '选择一个文件开始',
    filterPlaceholder: '搜索字段、值或来源…',
    copy: '复制安全摘要',
    copied: '已复制 ✓',
    exportJson: '导出完整 JSON',
    warnings: '注意事项',
    signals: 'AI 相关信号',
    rawData: '原始数据',
    none: '未发现可读元数据。',
    sensitiveExport: '完整导出可能包含 GPS、序列号、作者联系方式、提示词或 workflow JSON 等敏感元数据。确认继续导出？',
  },
  en: {
    loading: 'Loading parser…',
    analyzing: 'Analyzing…',
    done: 'Done',
    error: 'Error: ',
    noFile: 'Please choose a file',
    empty: 'Choose a file to begin',
    filterPlaceholder: 'Search fields, values, or sources…',
    copy: 'Copy safe summary',
    copied: 'Copied ✓',
    exportJson: 'Export full JSON',
    warnings: 'Warnings',
    signals: 'AI-related signals',
    rawData: 'Raw data',
    none: 'No readable metadata found.',
    sensitiveExport: 'Full export may contain GPS, serial numbers, author contacts, prompts, workflow JSON, or other sensitive metadata. Continue?',
  },
};

const SECTION_COPY = {
  'zh-CN': {
    home: '首页',
    tools: '工具',
    howTo: '如何使用',
    fields: '会展示哪些字段',
    limits: '适用范围与限制',
    faq: '常见问题',
    related: '相关工具与指南',
    noScript: '该工具需要 JavaScript 才能在本地解析文件；下方说明和常见问题无需 JavaScript 即可阅读。',
  },
  en: {
    home: 'Home',
    tools: 'Tools',
    howTo: 'How to use',
    fields: 'Fields shown',
    limits: 'Scope & limits',
    faq: 'FAQ',
    related: 'Related tools and guides',
    noScript: 'This tool needs JavaScript to parse files locally; the explanation and FAQ below are readable without it.',
  },
};

const pages = pageLang === 'en' ? TOOL_PAGES_EN : TOOL_PAGES_ZH;
const page = pages[Astro.params.tool];
const ui = UI_COPY[pageLang] ?? UI_COPY[DEFAULT_LANG];
const section = SECTION_COPY[pageLang] ?? SECTION_COPY[DEFAULT_LANG];
const currentPath = `${toolsPath}${page.tool}/`;
const currentUrl = `https://www.aicheck365.com${currentPath}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: page.h1,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Web browser',
    description: page.description,
    url: currentUrl,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    inLanguage: pageLang,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: section.home, item: `https://www.aicheck365.com${homePath}` },
      { '@type': 'ListItem', position: 2, name: section.tools, item: toolsUrl },
      { '@type': 'ListItem', position: 3, name: page.h1, item: currentUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base title={page.title} description={page.description} canonical={`https://www.aicheck365.com/tools/${page.tool}/`} jsonLd={jsonLd} alternateLangs={TOOL_ALTERNATE_LANGS}>
  <main class="page content-page">
    <article class="card content-article">
      <nav class="breadcrumb" aria-label="breadcrumb">
        <a href={homePath}>{section.home}</a>
        <span aria-hidden="true"> › </span>
        <a href={toolsPath}>{section.tools}</a>
        <span aria-hidden="true"> › </span>
        <span>{page.h1}</span>
      </nav>
      <h1>{page.h1}</h1>
      <p class="lead-text">{page.lead}</p>

      <section id="tool-inspector" data-tool={page.tool} class="card tool-card">
        <h2>{page.uploadTitle}</h2>
        <div class="tool-upload">
          <label class="tool-drop-zone" id="tool-drop-zone" for="tool-file-input">
            <input id="tool-file-input" type="file" accept={page.accept} />
            <span class="upload-icon" aria-hidden="true">↥</span>
            <span>{page.uploadZone}</span>
            <small class="muted">{page.formats}</small>
          </label>
          <p id="tool-status" class="status muted" role="status" aria-live="polite"></p>
          <div class="tool-toolbar">
            <input id="tool-filter" type="text" placeholder={ui.filterPlaceholder} aria-label={ui.filterPlaceholder} />
            <button id="tool-copy" class="ghost">{ui.copy}</button>
            <button id="tool-export" class="ghost">{ui.exportJson}</button>
          </div>
          <div id="tool-output" class="tool-output hidden"></div>
        </div>
        <noscript><p class="notice warning">{section.noScript}</p></noscript>
      </section>
      <script type="application/json" id="tool-i18n" set:html={JSON.stringify(ui)} />

      <h2>{section.howTo}</h2>
      <ol class="content-list">{page.usage.map((item) => <li>{item}</li>)}</ol>

      <h2>{section.fields}</h2>
      <table class="tool-glossary"><tbody>{page.fields.map((row) => <tr><th>{row[0]}</th><td>{row[1]}</td></tr>)}</tbody></table>

      <h2>{section.limits}</h2>
      <ul class="content-list">{page.limits.map((item) => <li>{item}</li>)}</ul>

      <h2>{section.faq}</h2>
      <dl class="faq-list">{page.faq.map((f) => (
        <Fragment>
          <dt>{f.q}</dt>
          <dd>{f.a}</dd>
        </Fragment>
      ))}</dl>

      <h2>{section.related}</h2>
      <ul class="content-list">
