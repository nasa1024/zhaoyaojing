    uploadZone: '点击或拖拽 MP4 / MOV / M4V 到此处',
    formats: '支持 MP4 / MOV / M4V 容器优先检查',
    accept: 'video/mp4,video/quicktime,video/x-m4v,.mp4,.mov,.m4v',
    usage: ['选择原始平台导出的视频；二次转码常会移除容器字段。', '先看摘要和 AI-related signals，再展开 box tree 与 ilst 字段。', '如容器无信号，可回到首页继续做抽样帧水印检测。'],
    fields: [
      ['ftyp', 'major_brand、minor_version、compatible_brands。'],
      ['udta/meta/ilst', 'encoder、software、tool、comment、AIGC 等可读字段。'],
      ['box tree', '展示 MP4/MOV box 路径、偏移和大小，便于专家定位字段来源。'],
    ],
    limits: ['当前专用页优先做容器检查，不在首屏加载 ffmpeg.wasm。', '无平台字段不代表视频不是 AI 生成；转码、剪辑、上传平台都会清除来源线索。', 'WebM/AVI 可先使用首页通用检测器做基础识别。'],
    faq: [
      { q: '这和首页 AI 视频检测有什么区别？', a: '本页是容器元数据检查器，只看 MP4/MOV 文件结构和可读字段。首页通用检测器还可以按需抽样视频帧做水印分析。' },
      { q: '能检测 Sora、Kling、Runway 吗？', a: '如果原始视频仍保留 C2PA-lite、MP4 字段、AIGC 标签、SEI marker 或平台字符串，就会作为来源线索显示。' },
      { q: '为什么不直接加载 ffmpeg？', a: 'PRD 要求容器优先，避免大文件一开始就加载重型抽帧引擎，减少内存和 Core Web Vitals 风险。' },
    ],
    related: [
      ['/platforms/sora/', 'Sora 视频检测指南'],
      ['/platforms/kling/', 'Kling 视频检测指南'],
      ['/blog/how-to-detect-ai-videos/', '如何检测 AI 视频'],
      ['/methodology/', '方法论与限制'],
    ],
