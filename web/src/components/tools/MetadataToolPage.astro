---
import Base from '../../layouts/Base.astro';

const SUPPORTED_LANGS = ['zh-CN', 'zh-TW', 'en', 'ja', 'ko', 'de', 'fr', 'es', 'pt-BR'];
const DEFAULT_LANG = 'zh-CN';
const TOOL_ALTERNATE_LANGS = ['zh-CN', 'en'];

function getUrlLang(pathname) {
  const seg = pathname.split('/').filter(Boolean)[0];
  return SUPPORTED_LANGS.includes(seg) ? seg : null;
}

const urlLang = getUrlLang(Astro.url.pathname);
const pageLang = urlLang === 'en' ? 'en' : DEFAULT_LANG;
const homePath = pageLang === 'en' ? '/en/' : '/';
const toolsPath = pageLang === 'en' ? '/en/tools/' : '/tools/';
const toolsUrl = `https://www.aicheck365.com${toolsPath}`;

function localizeHref(href) {
  if (pageLang !== 'en' || !href.startsWith('/')) return href;
  return href === '/' ? '/en/' : `/en${href}`;
}

const TOOL_PAGES_ZH = {
  'exif-xmp-reader': {
    tool: 'exif-xmp-reader',
    title: 'EXIF/XMP 阅读器：查看 AI 图片元数据 | AICheck365',
    description: 'EXIF/XMP 阅读器：在浏览器本地查看图片 EXIF、XMP、IPTC 与基础属性，搜索字段、复制安全摘要、导出 JSON，并高亮 AI 生成工具相关字段。',
    h1: 'EXIF/XMP 阅读器',
    lead: '上传一张原始图片，查看它保留的 EXIF、XMP、软件、时间、版权、位置和 AI/生成工具字段。工具会标记 GPS、序列号、作者联系方式、提示词等敏感字段；复制摘要默认跳过这些字段，完整 JSON 导出前会再次确认。',
    uploadTitle: '上传图片查看 EXIF / XMP',
    uploadZone: '点击或拖拽图片到此处',
    formats: '支持 JPEG / PNG / WebP / GIF / BMP / TIFF',
    accept: 'image/jpeg,image/png,image/webp,image/gif,image/bmp,image/tiff,.jpg,.jpeg,.png,.webp,.gif,.bmp,.tif,.tiff',
    usage: ['选择原始图片；社交平台压缩图往往已经丢失元数据。', '用搜索框查找字段名、软件名、平台名或字段值。', '复制 JSON 会生成安全摘要；如需完整导出，先确认是否包含敏感字段。'],
    fields: [
      ['AI / 生成工具', 'Software、CreatorTool、DigitalSourceType、AISystemUsed、AIPromptInformation 等。'],
      ['敏感字段', 'GPS、序列号、作者联系方式、UserComment、提示词和嵌入缩略图默认被标记。'],
      ['原始 XMP', '如果文件含 XMP packet，会作为可折叠 raw blob 展示，便于专家复核。'],
    ],
    limits: ['元数据可以被编辑、伪造或清除；单个字段不能作为法律级证明。', '未发现 EXIF/XMP 不代表图片不是 AI 生成，只说明当前文件没有保留这些可读字段。', '复制摘要会省略敏感字段；完整导出请先确认用途和保存范围。'],
    faq: [
      { q: '为什么有些图片没有 EXIF？', a: '许多平台会在上传、压缩、截图或重新导出时清除 EXIF/XMP。无字段只代表当前副本没有保留可读元数据。' },
