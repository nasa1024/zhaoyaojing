---
import Base from '../../layouts/Base.astro';

const SUPPORTED_LANGS = ['zh-CN', 'zh-TW', 'en', 'ja', 'ko', 'de', 'fr', 'es', 'pt-BR'];
const DEFAULT_LANG = 'zh-CN';
const TOOL_ALTERNATE_LANGS = ['zh-CN', 'en'];
function getUrlLang(pathname) {
  const seg = pathname.split('/').filter(Boolean)[0];
  return SUPPORTED_LANGS.includes(seg) ? seg : null;
}
const urlLang = getUrlLang(Astro.url.pathname);
const pageLang = urlLang === 'en' ? 'en' : DEFAULT_LANG;
const isZh = pageLang === 'zh-CN' || pageLang === 'zh-TW';
const toolsPath = pageLang === 'en' ? '/en/tools/' : '/tools/';
const homePath = pageLang === 'en' ? '/en/' : '/';
const methodologyPath = pageLang === 'en' ? '/en/methodology/' : '/methodology/';
const currentUrl = `https://www.aicheck365.com${toolsPath}`;

const title = isZh ? '专用检测工具 | AICheck365' : 'Detection Tools | AICheck365';
const description = isZh
  ? 'AICheck365 工具集：主页的 AI 图片/视频检测器负责一键识别 AI 来源线索；下方专用取证工具（C2PA 验证器、C2PA 查看器、EXIF/XMP 阅读器、PNG 参数提取器、MP4 元数据检查器）逐层查看原始来源数据，全部在浏览器本地完成。'
  : 'AICheck365 tools: the AI Image & Video Detector on the homepage runs the one-click origin check, while the forensic tools below (C2PA Validator, C2PA Viewer, EXIF/XMP Reader, PNG Parameter Extractor, MP4 Metadata Inspector) inspect raw per-layer data locally in your browser.';

const tools = [
  { slug: null, live: true, href: `${homePath}#upload-zone`,
    name: isZh ? 'AI 图片/视频检测器（主工具）' : 'AI Image & Video Detector (main tool)',
    desc: isZh ? '一键检测图片/视频里的 AI 来源线索：C2PA、EXIF、XMP、PNG 文本、MP4 元数据、文件名和视频帧水印，给出信号、置信度与字段详情。' : 'One-click AI-origin check for images and videos: C2PA, EXIF, XMP, PNG text, MP4 metadata, file-name clues, and frame watermarks, with signals, confidence, and field details.' },
  { slug: 'c2pa-validator', live: true,
    name: isZh ? 'C2PA 验证器' : 'C2PA Validator',
    desc: isZh ? '检查 C2PA Manifest、签名状态、Claim Generator、Assertions、Ingredient 链、证书与原始 JSON。' : 'Inspect C2PA manifest, signature state, claim generator, assertions, ingredient chain, certificate, and raw JSON.' },
  { slug: 'c2pa-viewer', live: true,
    name: isZh ? 'C2PA 查看器' : 'C2PA Viewer',
    desc: isZh ? '只提取并显示格式化后的 C2PA Content Credentials 原始 JSON，支持搜索、复制和导出。' : 'Extract only formatted raw C2PA Content Credentials JSON, with search, copy, and export.' },
  { slug: 'exif-xmp-reader', live: true,
    name: isZh ? 'EXIF/XMP 阅读器' : 'EXIF/XMP Reader',
    desc: isZh ? '查看 EXIF、XMP、基础属性和 AI 工具字段；敏感字段标记，复制安全摘要，导出 JSON。' : 'Inspect EXIF, XMP, base properties, and AI-tool fields with sensitive-field labels, safe copy, and JSON export.' },
  { slug: 'png-parameter-extractor', live: true,
    name: isZh ? 'PNG 参数/工作流提取器' : 'PNG Parameter / Workflow Extractor',
    desc: isZh ? '提取 PNG tEXt / iTXt / zTXt、Stable Diffusion parameters、ComfyUI workflow 和 NovelAI 线索。' : 'Extract PNG tEXt / iTXt / zTXt, Stable Diffusion parameters, ComfyUI workflow JSON, and NovelAI hints.' },
  { slug: 'mp4-metadata-inspector', live: true,
    name: isZh ? 'MP4 元数据检查器' : 'MP4 Metadata Inspector',
    desc: isZh ? '查看 MP4/MOV 容器 brand、box 树、ilst 字段、AIGC 标签、C2PA/JUMBF 文本和 SEI marker。' : 'Inspect MP4/MOV brands, box tree, ilst fields, AIGC labels, C2PA/JUMBF text, and SEI markers.' },
];
const soonLabel = isZh ? '即将上线' : 'Coming soon';

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage',
    name: title, description, url: currentUrl, inLanguage: pageLang },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: isZh ? '首页' : 'Home', item: `https://www.aicheck365.com${homePath}` },
      { '@type': 'ListItem', position: 2, name: isZh ? '工具' : 'Tools', item: currentUrl },
    ] },
];
---

<Base title={title} description={description} canonical="https://www.aicheck365.com/tools/" jsonLd={jsonLd} alternateLangs={TOOL_ALTERNATE_LANGS}>
  <main class="page content-page">
    <article class="card content-article">
      <nav class="breadcrumb" aria-label="breadcrumb">
        <a href={homePath}>{isZh ? '首页' : 'Home'}</a>
        <span aria-hidden="true"> › </span>
        <span>{isZh ? '工具' : 'Tools'}</span>
      </nav>
      <h1>{isZh ? '专用检测工具' : 'Detection Tools'}</h1>
      <p class="lead-text">{description}</p>
      <div class="tool-hub-grid">
        {tools.map((tool) => tool.live ? (
          <a class="tool-hub-card" href={tool.href ?? `${toolsPath}${tool.slug}/`}>
            <h3>{tool.name} →</h3>
            <p class="muted compact">{tool.desc}</p>
          </a>
        ) : (
          <div class="tool-hub-card soon">
            <h3>{tool.name}</h3>
            <p class="muted compact">{tool.desc}</p>
            <p class="muted compact"><strong>{soonLabel}</strong></p>
          </div>
        ))}
      </div>
      <p><a href={methodologyPath}>{isZh ? '方法论与限制 →' : 'Methodology & limits →'}</a></p>
    </article>
  </main>
</Base>
