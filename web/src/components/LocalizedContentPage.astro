          <li><a href="https://github.com/MatrixA/aicheck/issues" target="_blank" rel="noopener">GitHub Issues</a></li>
          <li><a href="https://github.com/MatrixA/aicheck/discussions" target="_blank" rel="noopener">GitHub Discussions</a></li>
        </ul>
        <h2>{c.sections.include}</h2>
        <ul class="content-list">
