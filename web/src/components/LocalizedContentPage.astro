        <h1>{c.aboutTitle}</h1>
        <p class="lead-text">{c.aboutLead}</p>
        <h2>{c.sections.signals}</h2>
        <p>{c.signalIntro}</p>
        <ul class="content-list">
          {c.aboutSignals.map((item) => <li>{item}</li>)}
        </ul>
        <h2>{c.sections.privacy}</h2>
        <p>{c.privacyLead}</p>
        <h2>{c.sections.limits}</h2>
        <p>{c.limitText}</p>
        <h2>{c.sections.next}</h2>
