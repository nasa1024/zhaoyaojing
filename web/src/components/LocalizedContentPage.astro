        {path.startsWith('platforms/') && <> › <a href={localHref('/platforms/')}>{c.platforms}</a></>}
        {' '}› {pageTitle}
      </nav>
    )}

    {path === 'blog' && (
      <>
        <div class="content-hero card">
          <h1>{c.blogTitle}</h1>
          <p class="lead-text">{c.blogDesc}</p>
        </div>
        <div class="blog-grid">
          {articles.map((article) => (
            <a href={localHref(`/blog/${article.slug}/`)} class="blog-card card">
              <div class="tag-row">
                {article.tags.map((tag) => <span class="tag-inline">{tag}</span>)}
              </div>
              <h2>{article.title}</h2>
              <p class="muted">{article.desc}</p>
              <span class="blog-meta">{c.updated} · AICheck365</span>
            </a>
          ))}
        </div>
      </>
    )}

    {path === 'platforms' && (
      <>
        <div class="content-hero card">
          <h1>{c.platformsTitle}</h1>
          <p class="lead-text">{c.platformsDesc}</p>
        </div>
