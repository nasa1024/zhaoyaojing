    )}

    {path === 'about' && (
      <article class="card content-article">
        <h1>{c.aboutTitle}</h1>
        <p class="lead-text">{c.aboutLead}</p>
        <h2>{c.sections.signals}</h2>
        <p>{c.signalIntro}</p>
