          <p>{platformDisclaimer}</p>
        </div>
        <div class="related-platforms card">
          <h2>{c.platforms}</h2>
          <div class="related-links">
            {relatedPlatforms.map((item) => (
              <a href={localHref(`/platforms/${item.slug}/`)}>{item.name} -></a>
            ))}
          </div>
        </div>
      </>
    )}

    {path === 'about' && (
