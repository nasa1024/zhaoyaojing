const defaultArticleLead = {
  'zh-CN': '这篇指南说明如何用原始文件里的可读线索辅助判断 AI 来源，并解释哪些场景会让检测失效。',
  'zh-TW': '這篇指南說明如何用原始檔案中的可讀線索輔助判斷 AI 來源，並解釋哪些情境會讓檢測失效。',
  en: 'This guide explains how to use readable signals from the original file to assess AI origin, and why some files lose those signals.',
  ja: 'このガイドでは、元ファイルに残る読み取り可能なシグナルで AI 由来を判断する方法と、シグナルが失われる条件を説明します。',
  ko: '이 가이드는 원본 파일의 읽을 수 있는 신호로 AI 출처를 판단하는 방법과 신호가 사라지는 경우를 설명합니다.',
  de: 'Dieser Guide erklärt, wie lesbare Signale aus der Originaldatei zur Einschätzung der AI-Herkunft helfen und wann sie verloren gehen.',
  fr: 'Ce guide explique comment utiliser les signaux lisibles du fichier original pour évaluer une origine IA, et pourquoi ils peuvent disparaître.',
  es: 'Esta guía explica cómo usar señales legibles del archivo original para evaluar origen IA y por qué algunas señales desaparecen.',
  'pt-BR': 'Este guia explica como usar sinais legíveis do arquivo original para avaliar origem de IA e por que alguns sinais desaparecem.',
};

const platforms = [
  { slug: 'gemini', name: 'Gemini', signals: ['C2PA', 'JUMBF', 'Google AI', 'MP4/MOV'] },
  { slug: 'imagen', name: 'Google Imagen', signals: ['C2PA', 'Content Credentials', 'Google AI', 'MP4/MOV'] },
  { slug: 'midjourney', name: 'Midjourney', signals: ['XMP', 'IPTC', 'file name'] },
  { slug: 'dall-e', name: 'DALL-E / GPT Image', signals: ['C2PA', 'XMP', 'OpenAI', 'Sora video'] },
  { slug: 'stable-diffusion', name: 'Stable Diffusion', signals: ['PNG tEXt', 'prompt', 'seed', 'frame export'] },
  { slug: 'firefly', name: 'Adobe Firefly', signals: ['C2PA', 'Content Credentials', 'XMP', 'MP4/MOV'] },
  { slug: 'flux', name: 'Flux (BFL)', signals: ['PNG tEXt', 'XMP', 'workflow', 'frame watermark'] },
  { slug: 'comfyui', name: 'ComfyUI', signals: ['workflow JSON', 'PNG tEXt', 'nodes', 'frame export'] },
  { slug: 'leonardo', name: 'Leonardo AI', signals: ['XMP', 'EXIF', 'Phoenix', 'video metadata'] },
  { slug: 'ideogram', name: 'Ideogram', signals: ['XMP', 'EXIF', 'text rendering', 'file name'] },
  { slug: 'sora', name: 'Sora', signals: ['C2PA-lite', 'MP4/MOV', 'OpenAI', 'frame watermark'] },
  { slug: 'kling', name: 'Kling', signals: ['MP4/MOV', 'SEI marker', 'AIGC label', 'frame watermark'] },
];

const videoPlatforms = ['Runway', 'Pika', 'Google Veo', 'Vidu', 'Luma', 'Hailuo', 'Pixverse', 'Wan'];

const c = localizedCopy[lang] ?? localizedCopy.en;
const path = pagePath.replace(/^\/|\/$/g, '');
const prefix = `/${lang}`;
const canonicalPath = `/${path}/`;
const canonical = `${SITE_URL}${canonicalPath}`;
const localHref = (target) => `${prefix}${target}`;
const titleFor = (key) => pageTitles[key]?.[lang] ?? pageTitles[key]?.en;
const articleTitle = titleFor(path);
const articleDesc = articleDescriptions[path]?.[lang] ?? articleDescriptions[path]?.en ?? c.blogDesc;
const platformSlug = path.startsWith('platforms/') ? path.split('/')[1] : null;
const platform = platforms.find((item) => item.slug === platformSlug);
const platformSeoName = platform?.name.endsWith('AI') ? platform.name : `${platform?.name} AI`;
const relatedPlatforms = ['dall-e', 'gemini', 'sora', 'kling']
  .map((slug) => platforms.find((item) => item.slug === slug))
  .filter((item) => item && item.slug !== platformSlug);
const publishedAt = '2026-05-26';
const modifiedAt = '2026-05-29';

function titleWithSuffix(title) {
  return `${title} | ${c.metaSuffix}`;
}

function platformMetaDescription(name) {
  const descriptions = {
    'zh-CN': `本地检测 ${name} 原始图片/视频中的 XMP、EXIF、C2PA、MP4/MOV 元数据、文件名和帧水印线索，不上传文件。`,
    'zh-TW': `本機檢測 ${name} 原始圖片/影片中的 XMP、EXIF、C2PA、MP4/MOV metadata、檔名和幀浮水印線索，不上傳檔案。`,
    en: `Check original ${name} AI images and videos locally for XMP, EXIF, C2PA, MP4/MOV metadata, file-name clues, and frame watermarks. No uploads.`,
    ja: `${name} の元画像/動画から XMP、EXIF、C2PA、MP4/MOV メタデータ、ファイル名、フレーム透かしをローカル検出。`,
    ko: `${name} 원본 이미지/비디오의 XMP, EXIF, C2PA, MP4/MOV 메타데이터, 파일명, 프레임 워터마크를 로컬로 검사합니다.`,
    de: `Prüfe originale ${name}-Bilder und -Videos lokal auf XMP, EXIF, C2PA, MP4/MOV-Metadaten, Dateinamen und Frame-Wasserzeichen.`,
    fr: `Vérifiez localement les images et vidéos ${name} avec XMP, EXIF, C2PA, métadonnées MP4/MOV, noms de fichier et filigranes.`,
    es: `Analiza imágenes y videos originales de ${name} con XMP, EXIF, C2PA, metadatos MP4/MOV, nombres de archivo y marcas de agua.`,
    'pt-BR': `Verifique imagens e vídeos originais do ${name} com XMP, EXIF, C2PA, metadados MP4/MOV, nomes de arquivo e marcas d'água.`,
  };
  return descriptions[lang] ?? descriptions.en;
}

function jsonLdBase(type, name, description) {
  const pageUrl = `${SITE_URL}${prefix}/${path}/`;
  return [
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: c.home, item: `${SITE_URL}${prefix}/` },
        { '@type': 'ListItem', position: 2, name, item: pageUrl },
      ],
    },
    {
      '@context': 'https://schema.org',
      '@type': type,
      name,
      headline: name,
      description,
      url: pageUrl,
      inLanguage: lang,
      isAccessibleForFree: true,
      datePublished: publishedAt,
      dateModified: modifiedAt,
      mainEntityOfPage: pageUrl,
      author: { '@type': 'Organization', name: 'AICheck365', url: SITE_URL },
      publisher: { '@type': 'Organization', name: 'AICheck365', url: SITE_URL },
    },
  ];
}

let pageTitle = c.aboutTitle;
let pageDescription = c.aboutDesc;
let jsonLd = jsonLdBase('WebPage', pageTitle, pageDescription);

if (path === 'blog') {
  pageTitle = c.blogTitle;
  pageDescription = c.blogDesc;
  jsonLd = jsonLdBase('CollectionPage', pageTitle, pageDescription);
} else if (path.startsWith('blog/')) {
  pageTitle = articleTitle;
  pageDescription = articleDesc;
  jsonLd = jsonLdBase('Article', pageTitle, pageDescription);
} else if (path === 'platforms') {
  pageTitle = c.platformsTitle;
  pageDescription = c.platformsDesc;
  jsonLd = jsonLdBase('CollectionPage', pageTitle, pageDescription);
} else if (platform) {
  pageTitle = `${platformSeoName} Image/Video Detection Guide`;
  if (lang === 'zh-CN') pageTitle = `${platformSeoName} 图片/视频检测指南`;
  if (lang === 'zh-TW') pageTitle = `${platformSeoName} 圖片/影片檢測指南`;
  if (lang === 'ja') pageTitle = `${platformSeoName} 画像/動画検出ガイド`;
  if (lang === 'ko') pageTitle = `${platformSeoName} 이미지/비디오 감지 가이드`;
  if (lang === 'de') pageTitle = `${platform.name} AI-Bild- und Videoprüfung`;
  if (lang === 'fr') pageTitle = `Guide de détection image/vidéo IA ${platform.name}`;
  if (lang === 'es') pageTitle = `Guía de detección de imagen/video IA de ${platform.name}`;
  if (lang === 'pt-BR') pageTitle = `Guia de detecção de imagem/vídeo de IA do ${platform.name}`;
  pageDescription = platformMetaDescription(platform.name);
  jsonLd = jsonLdBase('Article', pageTitle, pageDescription);
} else if (path === 'contact') {
  pageTitle = c.contactTitle;
  pageDescription = c.contactDesc;
  jsonLd = jsonLdBase('ContactPage', pageTitle, pageDescription);
} else if (path === 'privacy') {
  pageTitle = c.privacyTitle;
  pageDescription = c.privacyDesc;
  jsonLd = jsonLdBase('WebPage', pageTitle, pageDescription);
} else if (path === 'terms') {
  pageTitle = c.termsTitle;
  pageDescription = c.termsDesc;
  jsonLd = jsonLdBase('WebPage', pageTitle, pageDescription);
}

const articles = Object.keys(pageTitles).map((slug) => ({
  slug: slug.replace('blog/', ''),
  title: titleFor(slug),
  desc: articleDescriptions[slug]?.[lang] ?? articleDescriptions[slug]?.en ?? defaultArticleLead[lang],
  tags: slug.includes('videos') ? ['AI video', 'MP4', 'C2PA'] : slug.includes('c2pa') ? ['C2PA', 'metadata'] : ['AI media', 'metadata'],
}));
---

<Base title={titleWithSuffix(pageTitle)} description={pageDescription} canonical={canonical} jsonLd={jsonLd}>
  <main class="page content-page">
    {path !== 'blog' && path !== 'platforms' && (
      <nav class="breadcrumb">
        <a href={localHref('/')}>{c.home}</a>
        {path.startsWith('blog/') && <> › <a href={localHref('/blog/')}>{c.blog}</a></>}
        {path.startsWith('platforms/') && <> › <a href={localHref('/platforms/')}>{c.platforms}</a></>}
        {' '}› {pageTitle}
      </nav>
    )}

    {path === 'blog' && (
      <>
        <div class="content-hero card">
          <h1>{c.blogTitle}</h1>
          <p class="lead-text">{c.blogDesc}</p>
        </div>
        <div class="blog-grid">
          {articles.map((article) => (
            <a href={localHref(`/blog/${article.slug}/`)} class="blog-card card">
              <div class="tag-row">
                {article.tags.map((tag) => <span class="tag-inline">{tag}</span>)}
              </div>
              <h2>{article.title}</h2>
              <p class="muted">{article.desc}</p>
              <span class="blog-meta">{c.updated} · AICheck365</span>
            </a>
          ))}
        </div>
      </>
    )}

    {path === 'platforms' && (
      <>
        <div class="content-hero card">
          <h1>{c.platformsTitle}</h1>
          <p class="lead-text">{c.platformsDesc}</p>
        </div>
        <div class="platform-grid">
          {platforms.map((item) => (
            <a href={localHref(`/platforms/${item.slug}/`)} class="platform-card card">
              <div class="platform-card-header">
                <h2>{item.name}</h2>
                <div class="tag-row">
                  {item.signals.slice(0, 3).map((tag) => <span class="tag-inline">{tag}</span>)}
                </div>
              </div>
              <p>{c.platformLead(item.name)}</p>
              <span class="card-link">{c.read} -></span>
            </a>
          ))}
        </div>
        <div class="card content-section">
          <h2>{c.sections.signals}</h2>
          <p>{c.signalIntro}</p>
          <p>{videoPlatforms.join(', ')}: MP4/MOV, C2PA-lite, SEI marker, file-name hints, sampled frame watermarks.</p>
        </div>
      </>
    )}

    {path.startsWith('blog/') && (
      <article class="card content-article">
        <h1>{pageTitle}</h1>
        <p class="article-meta">{c.updated} · AI media detection · AICheck365</p>
        <p class="lead-text">{articleDesc === c.blogDesc ? defaultArticleLead[lang] : articleDesc}</p>
        <h2>{c.sections.signals}</h2>
        <p>{c.signalIntro}</p>
        <ul class="content-list">
          {c.blogSignals.map((item) => <li>{item}</li>)}
        </ul>
        <h2>{c.sections.limits}</h2>
        <p>{c.limitText}</p>
        <h2>{c.sections.privacy}</h2>
        <p>{c.privacyText}</p>
        <h2>{c.sections.next}</h2>
        <p>{defaultArticleLead[lang]} {c.signalIntro}</p>
        <p>{c.limitText}</p>
        <div class="cta-box">
          <p>{c.inspect}</p>
          <a href={localHref('/')} class="primary" style="display:inline-block;text-decoration:none;padding:12px 28px;">{c.inspect} -></a>
        </div>
      </article>
    )}

    {platform && (
      <>
        <article class="card content-article">
          <h1>{pageTitle}</h1>
          <p class="lead-text">{c.platformLead(platform.name)}</p>
          <h2>{c.sections.signals}</h2>
          <p>{c.signalIntro}</p>
          <ul class="content-list">
            {platform.signals.map((signal) => <li><strong>{signal}</strong>: {platform.name}</li>)}
          </ul>
          <h2>{c.sections.limits}</h2>
          <p>{c.limitText}</p>
          <h2>{c.sections.privacy}</h2>
          <p>{c.privacyText}</p>
          <ul class="content-list">
            <li>{c.platformLead(platform.name)}</li>
            <li>{c.signalIntro}</li>
            <li>{c.limitText}</li>
          </ul>
          <h2>{c.sections.next}</h2>
          <p>{c.platformCta(platform.name)}.</p>
          <div class="cta-box">
            <a href={localHref('/')} class="primary" style="display:inline-block;text-decoration:none;padding:12px 28px;">{c.inspect} -></a>
          </div>
        </article>
        <div class="related-platforms card">
          <h2>{c.platforms}</h2>
          <div class="related-links">
            {relatedPlatforms.map((item) => (
              <a href={localHref(`/platforms/${item.slug}/`)}>{item.name} -></a>
            ))}
          </div>
        </div>
      </>
    )}

    {path === 'about' && (
      <article class="card content-article">
        <h1>{c.aboutTitle}</h1>
        <p class="lead-text">{c.aboutLead}</p>
        <h2>{c.sections.signals}</h2>
        <p>{c.signalIntro}</p>
        <ul class="content-list">
          {c.aboutSignals.map((item) => <li>{item}</li>)}
        </ul>
        <h2>{c.sections.privacy}</h2>
        <p>{c.privacyLead}</p>
        <h2>{c.sections.limits}</h2>
        <p>{c.limitText}</p>
        <h2>{c.sections.next}</h2>
        <p>{c.platformsDesc}</p>
        <p>{c.blogDesc}</p>
        <p>{c.privacyText}</p>
        <p>{c.signalIntro}</p>
      </article>
    )}

    {path === 'contact' && (
      <article class="card content-article">
        <h1>{c.contactTitle}</h1>
        <p class="lead-text">{c.contactLead}</p>
        <h2>Email</h2>
        <p><a href="mailto:contact@aicheck365.com">contact@aicheck365.com</a></p>
        <h2>GitHub</h2>
        <ul class="content-list">
          <li><a href="https://github.com/MatrixA/aicheck/issues" target="_blank" rel="noopener">GitHub Issues</a></li>
          <li><a href="https://github.com/MatrixA/aicheck/discussions" target="_blank" rel="noopener">GitHub Discussions</a></li>
        </ul>
        <h2>{c.sections.include}</h2>
        <ul class="content-list">
          {c.contactInclude.map((item) => <li>{item}</li>)}
        </ul>
        <h2>{c.sections.privacy}</h2>
        <p>{c.privacyText}</p>
        <h2>{c.sections.limits}</h2>
        <p>{c.limitText}</p>
        <h2>{c.sections.next}</h2>
        <p>{c.platformsDesc}</p>
        <p>{c.blogDesc}</p>
        <p>{c.signalIntro}</p>
        <p>{c.aboutLead}</p>
      </article>
    )}

    {path === 'privacy' && (
      <article class="card content-article">
        <h1>{c.privacyTitle}</h1>
        <p class="lead-text">{c.privacyLead}</p>
        <h2>{c.sections.privacy}</h2>
        <p>{c.privacyText}</p>
        <h2>{c.sections.signals}</h2>
        <p>{c.signalIntro}</p>
        <h2>{c.sections.limits}</h2>
        <p>{c.limitText}</p>
        <h2>{c.sections.next}</h2>
        <p>{c.inspect}</p>
        <p>{c.platformsDesc}</p>
        <p>{c.limitText}</p>
        <p>{c.signalIntro}</p>
        <p>{c.aboutLead}</p>
      </article>
    )}

    {path === 'terms' && (
      <article class="card content-article">
        <h1>{c.termsTitle}</h1>
        <p class="lead-text">{c.termsLead}</p>
        <h2>{c.sections.signals}</h2>
        <p>{c.signalIntro}</p>
        <h2>{c.sections.limits}</h2>
        <p>{c.limitText}</p>
        <h2>{c.sections.privacy}</h2>
        <p>{c.privacyText}</p>
        <h2>{c.sections.next}</h2>
        <p>{c.inspect}</p>
        <p>{c.blogDesc}</p>
        <p>{c.platformsDesc}</p>
        <p>{c.signalIntro}</p>
        <p>{c.aboutLead}</p>
        <p>{c.termsLead}</p>
      </article>
    )}
  </main>
</Base>
