        <h2>{c.sections.privacy}</h2>
        <p>{c.privacyText}</p>
        <h2>{c.sections.next}</h2>
        <p>{defaultArticleLead[lang]} {c.signalIntro}</p>
        <p>{c.limitText}</p>
        <div class="cta-box">
          <p>{c.inspect}</p>
          <a href={localHref('/')} class="primary" style="display:inline-block;text-decoration:none;padding:12px 28px;">{c.inspect} -></a>
        </div>
      </article>
    )}

    {priorityPlatformProfile && (
      <>
        <article class="card content-article priority-seo-page" data-priority-page={path}>
          <h1>{priorityPlatformProfile.h1}</h1>
          <p class="article-meta">{priorityPlatformProfile.meta}</p>
          <p class="lead-text">{priorityPlatformProfile.lead}</p>

          {priorityPlatformProfile.directAnswer && (
            <section id="direct-answer" class="priority-direct-answer" data-content-section="direct-answer">
              <h2>{priorityPlatformProfile.directAnswer.heading}</h2>
              <p>{priorityPlatformProfile.directAnswer.body}</p>
            </section>
