        <p>{c.privacyLead}</p>
        <h2>{c.sections.limits}</h2>
        <p>{c.limitText}</p>
        <h2>{c.sections.next}</h2>
        <p>{c.platformsDesc}</p>
        <p>{c.blogDesc}</p>
        <p>{c.privacyText}</p>
        <p>{c.signalIntro}</p>
      </article>
