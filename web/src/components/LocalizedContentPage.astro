    {path === 'privacy' && (
      <article class="card content-article">
        <h1>{c.privacyTitle}</h1>
        <p class="lead-text">{c.privacyLead}</p>
        <h2>{c.sections.privacy}</h2>
        <p>{c.privacyText}</p>
        <h2>{c.sections.signals}</h2>
        <p>{c.signalIntro}</p>
        <h2>{c.sections.limits}</h2>
        <p>{c.limitText}</p>
        <h2>{c.sections.next}</h2>
        <p>{c.inspect}</p>
        <p>{c.platformsDesc}</p>
        <p>{c.limitText}</p>
        <p>{c.signalIntro}</p>
        <p>{c.aboutLead}</p>
      </article>
    )}

    {path === 'terms' && (
      <article class="card content-article">
        <h1>{c.termsTitle}</h1>
        <p class="lead-text">{c.termsLead}</p>
        <h2>{c.sections.signals}</h2>
        <p>{c.signalIntro}</p>
        <h2>{c.sections.limits}</h2>
        <p>{c.limitText}</p>
        <h2>{c.sections.privacy}</h2>
        <p>{c.privacyText}</p>
        <h2>{c.sections.next}</h2>
        <p>{c.inspect}</p>
        <p>{c.blogDesc}</p>
        <p>{c.platformsDesc}</p>
        <p>{c.signalIntro}</p>
        <p>{c.aboutLead}</p>
        <p>{c.termsLead}</p>
      </article>
    )}
  </main>
</Base>
