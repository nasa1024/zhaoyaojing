---
import { homeStrings, resolveLang } from '../i18n/home.js';
const m = homeStrings(resolveLang(Astro.url.pathname)).methodology;
---

<section class="methodology-block card content-section" id="methodology">
  <h2 class="methodology-heading">{m.section}</h2>
  <div class="methodology-cols">
    <div class="methodology-col methodology-col--can">
      <h3 class="methodology-col-title">{m.can}</h3>
      <ul class="methodology-list methodology-list--can">
        {m.canList.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div class="methodology-col methodology-col--cannot">
      <h3 class="methodology-col-title">{m.cannot}</h3>
      <ul class="methodology-list methodology-list--cannot">
        {m.cannotList.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
  <p class="methodology-slogan">{m.slogan}</p>
  <a href="/methodology/" class="methodology-link">{m.link} →</a>
</section>
