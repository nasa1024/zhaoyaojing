---
import samples from '../../public/data/samples.json';
import { homeStrings, resolveLang } from '../i18n/home.js';
const h = homeStrings(resolveLang(Astro.url.pathname)).sample;
---

<section class="sample-experience card content-section" id="sample-experience">
  <h2>{h.title}</h2>
  {samples.length > 0 && <p class="muted compact">{h.subtitle}</p>}
  {samples.length === 0 ? (
    <p class="muted sample-placeholder">{h.soon}</p>
  ) : (
    <div class="sample-cards">
      {samples.map((s: any) => (
        <article
          class="sample-card card"
          data-file-ref={s.fileRef}
          data-sample-id={s.id}
          tabindex="0"
          role="button"
          aria-label={`${s.title} — ${h.title}`}
        >
          {/\.(jpe?g|png|webp|gif|avif)$/i.test(s.fileRef ?? '') ? (
            <img class="sample-thumb" src={s.fileRef} alt={s.title} loading="lazy" decoding="async" />
          ) : (
            <div class="sample-thumb sample-thumb--video" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="M7 4v16M17 4v16M2 9h5M2 15h5M17 9h5M17 15h5" />
              </svg>
              <span>{s.fileFormat}</span>
            </div>
          )}
          <div class="sample-card-header">
            <strong class="sample-title">{s.title}</strong>
            <span class="tag-inline">{s.platform}</span>
          </div>
          <div class="sample-meta">
            <span>{s.fileFormat}</span>
            <span class={`badge ${s.processed ? 'low' : 'none'}`}>{s.processed ? h.processed : h.unprocessed}</span>
            {s.testDate && <span class="muted">{s.testDate}</span>}
          </div>
          {s.source && (
            <p class="muted sample-source">{h.source}: {s.source}</p>
          )}
          {s.signals?.length > 0 && (
            <p class="muted sample-signals">{s.signals.length} {h.signals}: {s.signals.join(', ')}</p>
          )}
          {s.knownLimits?.length > 0 && (
            <ul class="sample-limits muted">
              <li class="sample-limits-title">{h.limits}:</li>
              {s.knownLimits.map((k: string) => <li>{k}</li>)}
            </ul>
          )}
        </article>
      ))}
    </div>
  )}
</section>
