---
import Base from '../layouts/Base.astro';

interface Props {
  lang: 'en' | 'zh-TW';
}

const { lang } = Astro.props;
const SITE_URL = 'https://www.aicheck365.com';

const data = {
  en: {
    title: 'AI Detection and Provenance Blog | AICheck365',
    description: 'Practical articles about AI content provenance, Claude watermarking, C2PA, image and video metadata, platform signals, and evidence limits.',
    canonical: `${SITE_URL}/en/blog/`,
    h1: 'AICheck365 Blog: AI Detection and Provenance',
    lead: 'Evidence-first articles about AI content marking, C2PA, metadata, platform signals, and the limits of automated detection.',
    featured: 'Featured article',
    featuredRead: 'Read the full analysis',
    more: 'More articles',
    read: 'Read the article',
    updated: 'Updated',
    articles: [
      {
        href: '/en/blog/claude-watermark-explained/',
        title: 'Claude Watermark: Benefits, Limits and Alternatives',
        description: 'What Anthropic’s new machine-readable text mark can prove, what it cannot prove, and how it compares with SynthID, C2PA, visible labels, metadata, and AI detectors.',
        updatedAt: '2026-08-11',
        tags: ['Claude', 'Text watermark', 'Provenance'],
      },
      {
        href: '/en/blog/how-to-detect-ai-images/',
        title: 'How to Tell If an Image Is AI-Generated',
        description: 'Read C2PA Content Credentials, EXIF/XMP, and PNG generation parameters from the original file instead of relying on visual guesses.',
        updatedAt: '2026-07-23',
        tags: ['AI image', 'C2PA', 'Metadata'],
      },
      {
        href: '/en/blog/how-to-detect-ai-videos/',
        title: 'How to Check If a Video Is AI-Generated',
        description: 'Check an original MP4/MOV for C2PA, container metadata, SEI markers, file-name clues, and sampled frame watermarks.',
        updatedAt: '2026-07-23',
        tags: ['AI video', 'MP4', 'Watermark'],
      },
      {
        href: '/en/blog/how-to-detect-gemini-generated-images/',
        title: 'How to Check If a Gemini Image Is AI-Generated',
        description: 'Inspect Gemini and Google AI files for C2PA, digitalSourceType, claim generator strings, XMP fields, and the limits of SynthID attribution.',
        updatedAt: '2026-07-23',
        tags: ['Gemini', 'SynthID', 'C2PA'],
      },
      {
        href: '/en/blog/ai-image-metadata-guide/',
        title: 'AI Image Metadata Explained: EXIF, XMP, C2PA and PNG',
        description: 'Where AI platforms write provenance data, how each field should be interpreted, and what disappears after sharing or re-exporting.',
        updatedAt: '2026-07-23',
        tags: ['EXIF', 'XMP', 'PNG'],
      },
      {
        href: '/en/blog/what-is-c2pa/',
        title: 'What Is C2PA? Content Credentials Explained',
        description: 'How signed provenance manifests work, what validity and trust mean, and why missing credentials do not prove human origin.',
        updatedAt: '2026-07-23',
        tags: ['C2PA', 'Content Credentials', 'Provenance'],
      },
    ],
  },
  'zh-TW': {
    title: 'AI 內容檢測與來源驗證部落格 | AICheck365',
    description: '實用文章：Claude 浮水印、C2PA、AI 圖片與影片 metadata、平台來源線索、證據強度與自動偵測限制。',
    canonical: `${SITE_URL}/zh-TW/blog/`,
    h1: 'AICheck365 部落格：AI 內容檢測與來源驗證',
    lead: '以可驗證證據為核心，整理 AI 內容標記、C2PA、metadata、平台來源線索與自動偵測的限制。',
    featured: '精選文章',
    featuredRead: '閱讀完整分析',
    more: '更多文章',
    read: '閱讀文章',
    updated: '更新',
    articles: [
      {
        href: '/zh-TW/blog/claude-watermark-explained/',
        title: 'Claude 浮水印：優點、限制與現有方案比較',
        description: '解析 Anthropic 新機器可讀文字標記能證明什麼、不能證明什麼，並比較 SynthID、C2PA、可見標籤、metadata 與 AI 文字偵測器。',
        updatedAt: '2026-08-11',
        tags: ['Claude', '文字浮水印', '來源驗證'],
      },
      {
        href: '/zh-TW/blog/how-to-detect-ai-images/',
        title: '如何判斷圖片是否由 AI 生成？C2PA、EXIF 與 PNG Metadata 實測',
        description: '從原始檔案讀取 C2PA 簽章、EXIF/XMP 與 PNG 生成參數，而不是只靠畫面猜測。',
        updatedAt: '2026-07-23',
        tags: ['AI 圖片', 'C2PA', 'Metadata'],
      },
      {
        href: '/zh-TW/blog/how-to-detect-ai-videos/',
        title: '如何判斷 AI 生成影片？MP4 Metadata、C2PA 與影格浮水印實測',
        description: '檢查原始 MP4/MOV 的 C2PA、容器 metadata、SEI marker、檔名與抽樣影格浮水印。',
        updatedAt: '2026-07-23',
        tags: ['AI 影片', 'MP4', '浮水印'],
      },
      {
        href: '/zh-TW/blog/how-to-detect-gemini-generated-images/',
        title: '如何判斷圖片是不是 Gemini 生成？C2PA 實測',
        description: '檢查 Gemini 與 Google AI 檔案中的 C2PA、digitalSourceType、claim generator、XMP，以及 SynthID 歸因的限制。',
        updatedAt: '2026-07-23',
        tags: ['Gemini', 'SynthID', 'C2PA'],
      },
      {
        href: '/zh-TW/blog/ai-image-metadata-guide/',
        title: 'AI 圖片 Metadata 怎麼看？EXIF、XMP、C2PA 拆解',
        description: '了解 AI 平台把來源資訊寫在哪裡、每個欄位應如何解讀，以及分享或重新匯出後會消失哪些證據。',
        updatedAt: '2026-07-23',
        tags: ['EXIF', 'XMP', 'PNG'],
      },
      {
        href: '/zh-TW/blog/what-is-c2pa/',
        title: 'C2PA 是什麼？AI 內容憑證與來源驗證完整解析',
        description: '說明簽章式來源 manifest、有效與可信的差別，以及為什麼沒有 Content Credentials 不能反推為人類作品。',
        updatedAt: '2026-07-23',
        tags: ['C2PA', '內容憑證', '來源驗證'],
      },
    ],
  },
};

const c = data[lang];
const [featuredArticle, ...otherArticles] = c.articles;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: c.h1,
    description: c.description,
    url: c.canonical,
    inLanguage: lang,
    isAccessibleForFree: true,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: c.articles.map((article, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: article.title,
        url: `${SITE_URL}${article.href}`,
      })),
    },
  },
];
---

<Base title={c.title} description={c.description} canonical={c.canonical} lang={lang} jsonLd={jsonLd}>
  <main class="page content-page blog-index-page">
    <div class="content-hero card">
      <h1>{c.h1}</h1>
      <p class="lead-text">{c.lead}</p>
    </div>

    <section class="featured-article-section" aria-labelledby="featured-article-label">
      <p class="featured-article-label" id="featured-article-label">{c.featured}</p>
      <a
        href={featuredArticle.href}
        class="featured-article-card card"
        data-featured-article
        aria-label={`${c.featured}: ${featuredArticle.title}`}
      >
        <div class="featured-article-copy">
          <div class="tag-row">
            {featuredArticle.tags.map((tag) => <span class="tag-inline">{tag}</span>)}
          </div>
          <h2>{featuredArticle.title}</h2>
          <p>{featuredArticle.description}</p>
          <div class="featured-article-meta">
            <span>{c.updated} {featuredArticle.updatedAt}</span>
            <strong>{c.featuredRead} →</strong>
          </div>
        </div>
        <div class="featured-article-mark" aria-hidden="true">
          <span>Claude</span>
          <strong>AI</strong>
          <small>watermark</small>
        </div>
      </a>
    </section>

    <section aria-labelledby="more-articles-heading">
      <h2 class="blog-section-heading" id="more-articles-heading">{c.more}</h2>
      <div class="blog-grid">
        {otherArticles.map((article) => (
          <a href={article.href} class="blog-card card">
            <div class="tag-row">
              {article.tags.map((tag) => <span class="tag-inline">{tag}</span>)}
            </div>
            <h3>{article.title}</h3>
            <p class="muted">{article.description}</p>
            <span class="blog-meta">{c.updated} {article.updatedAt}</span>
            <span class="card-link">{c.read} →</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</Base>

<style>
  .featured-article-section {
    margin: 28px 0 36px;
  }

  .featured-article-label,
  .blog-section-heading {
    margin: 0 0 12px;
  }

  .featured-article-label {
    font-size: .82rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .featured-article-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 190px;
    gap: 28px;
    align-items: stretch;
    padding: 30px;
    text-decoration: none;
    border-width: 2px;
  }

  .featured-article-card:hover {
    transform: translateY(-2px);
  }

  .featured-article-copy h2 {
    margin: 14px 0 12px;
    font-size: clamp(1.55rem, 3vw, 2.25rem);
  }

  .featured-article-copy > p {
    margin: 0;
    max-width: 760px;
    color: var(--text-muted);
    line-height: 1.75;
  }

  .featured-article-meta {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    margin-top: 24px;
    color: var(--text-muted);
  }

  .featured-article-meta strong {
    color: var(--text);
  }

  .featured-article-mark {
    display: flex;
    min-height: 180px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface-2);
    font-family: 'Space Grotesk', sans-serif;
  }

  .featured-article-mark span,
  .featured-article-mark small {
    color: var(--text-muted);
    letter-spacing: .08em;
  }

  .featured-article-mark strong {
    font-size: 4.4rem;
    line-height: .95;
  }

  .blog-section-heading {
    font-size: 1.35rem;
  }

  .blog-card h3 {
    margin: 14px 0 10px;
    font-size: 1.2rem;
  }

  @media (max-width: 720px) {
    .featured-article-card {
      grid-template-columns: 1fr;
      padding: 22px;
    }

    .featured-article-mark {
      min-height: 120px;
    }

    .featured-article-meta {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
