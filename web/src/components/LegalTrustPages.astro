            [s('Sampled video frame watermarks & file-name heuristics'), ': lazy-loads ', c('ffmpeg.wasm'), ' locally when container metadata does not match, checking sampled frames for known visible or invisible watermark patterns alongside weak file-name hints.'],
          ],
          afterParagraphs: [
            ['For how we rank cryptographic evidence versus editable metadata, see our ', tLink('Detection Methodology', localHref('/methodology/')), '.'],
          ],
        },
