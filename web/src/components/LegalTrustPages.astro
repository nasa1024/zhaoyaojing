---
interface Props {
  lang: string;
  pagePath: string;
}

const { lang, pagePath } = Astro.props;

const SUPPORTED_PREFIXED = ['zh-TW', 'en', 'ja', 'ko', 'de', 'fr', 'es', 'pt-BR'] as const;
type LocaleKey = (typeof SUPPORTED_PREFIXED)[number];

const resolvedLang: LocaleKey = (SUPPORTED_PREFIXED as readonly string[]).includes(lang)
  ? (lang as LocaleKey)
  : 'en';
const prefix = lang === 'zh-CN' ? '' : `/${resolvedLang}`;
const localHref = (p: string) => `${prefix}${p}`;

type InlinePart =
  | string
  | { label: string; href: string; external?: boolean }
  | { strong: string }
  | { code: string };

interface SectionBlock {
  id?: string;
  heading: string;
  paragraphs?: InlinePart[][];
  list?: InlinePart[][];
  afterParagraphs?: InlinePart[][];
}

interface StatCard {
  icon: string;
  label: string;
  desc: string;
  href?: string;
}

interface LegalPageData {
  h1: string;
  meta?: string;
  lead: string;
  stats?: StatCard[];
  sections: SectionBlock[];
}

interface LocaleLegalContent {
  about: LegalPageData;
  contact: LegalPageData;
  privacy: LegalPageData;
  terms: LegalPageData;
}

const tLink = (label: string, href: string, external = false): InlinePart => ({
  label,
  href,
  external,
});
const s = (strong: string): InlinePart => ({ strong });
const c = (code: string): InlinePart => ({ code });

const REPO_URL = 'https://github.com/nasa1024/zhaoyaojing';
const REPO_ISSUES_URL = 'https://github.com/nasa1024/zhaoyaojing/issues';
const REPO_DISCUSSIONS_URL = 'https://github.com/nasa1024/zhaoyaojing/discussions';
const UPSTREAM_URL = 'https://github.com/MatrixA/aicheck';
const IMPACT_PRIVACY_URL = 'https://impact.com/privacy-policy/';
const CLOUDFLARE_PRIVACY_URL = 'https://www.cloudflare.com/privacypolicy/';
const GOOGLE_PRIVACY_URL = 'https://policies.google.com/privacy';
const GOOGLE_OPTOUT_URL = 'https://tools.google.com/dlpage/gaoptout';
const GOOGLE_ADS_URL = 'https://adssettings.google.com';
const ASTRO_URL = 'https://astro.build';
const MAILTO_MAIN = 'mailto:contact@aicheck365.com';
const MAILTO_PARTNERSHIP = 'mailto:contact@aicheck365.com?subject=PARTNERSHIP';

const CONTENT: Record<LocaleKey, LocaleLegalContent> = {
  en: {
    about: {
      h1: 'About AICheck365',
      lead: 'AICheck365 (also known as AICheck) is a free, local-first AI image and video origin detector that inspects verifiable provenance signals inside original media files without uploading them to a server.',
      stats: [
        { icon: '⭐', label: 'Open Source Repo', desc: 'nasa1024/zhaoyaojing', href: REPO_URL },
        { icon: '🌐', label: '9 Languages', desc: 'EN, ZH, JA, KO, DE, FR, ES, PT-BR' },
        { icon: '🔒', label: '100% Local', desc: 'Files never leave your device' },
        { icon: '🆓', label: 'Free to Use', desc: 'No sign-up or upload required' },
      ],
      sections: [
        {
          heading: 'Mission & Browser-Local Verification Signals',
          paragraphs: [
            ['Instead of relying on opaque neural classifiers that guess from pixels alone, AICheck365 reads the actual provenance signals preserved in your original file and shows the exact field or signature behind every finding:'],
          ],
          list: [
            [s('C2PA Content Credentials / JUMBF'), ': validates digital signatures, ', c('claim_generator'), ', and ', c('digitalSourceType'), ' declarations.'],
            [s('EXIF & XMP metadata'), ': checks ', c('Software'), ', ', c('CreatorTool'), ', ', c('Credit'), ', and ', c('DigitalSourceType'), ' tags written by cameras or AI tools.'],
