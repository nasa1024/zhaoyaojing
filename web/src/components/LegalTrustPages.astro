const pageKey = (['about', 'contact', 'privacy', 'terms'].includes(pagePath) ? pagePath : 'about') as keyof LocaleLegalContent;
const data: LegalPageData = CONTENT[resolvedLang]?.[pageKey] ?? CONTENT.en[pageKey];

function escapeHtml(str: string) {
  return str
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

function renderInline(parts: InlinePart[]) {
  return parts
    .map((part) => {
      if (typeof part === 'string') return escapeHtml(part);
      if ('strong' in part) return `<strong>${escapeHtml(part.strong)}</strong>`;
      if ('code' in part) return `<code>${escapeHtml(part.code)}</code>`;
      const attrs = part.external ? ' target="_blank" rel="noopener noreferrer"' : '';
      return `<a href="${escapeHtml(part.href)}"${attrs}>${escapeHtml(part.label)}</a>`;
    })
    .join('');
}
---

<article class="card content-article" data-legal-page={pageKey} data-legal-lang={resolvedLang}>
  <h1>{data.h1}</h1>
  {data.meta && <p class="article-meta">{data.meta}</p>}
  <p class="lead-text">{data.lead}</p>

  {data.stats && (
    <div class="about-stats">
      {data.stats.map((card) =>
        card.href ? (
          <a href={card.href} target="_blank" rel="noopener noreferrer" class="stat-card">
            <span class="stat-icon">{card.icon}</span>
            <span class="stat-label">{card.label}</span>
            <span class="stat-desc">{card.desc}</span>
          </a>
        ) : (
          <div class="stat-card">
            <span class="stat-icon">{card.icon}</span>
            <span class="stat-label">{card.label}</span>
            <span class="stat-desc">{card.desc}</span>
          </div>
        )
      )}
    </div>
  )}

  {data.sections.map((section) => (
    <section id={section.id}>
      <h2>{section.heading}</h2>
      {section.paragraphs?.map((parts) => (
        <p set:html={renderInline(parts)} />
      ))}
      {section.list && (
        <ul class="content-list">
          {section.list.map((parts) => (
            <li set:html={renderInline(parts)} />
          ))}
        </ul>
      )}
      {section.afterParagraphs?.map((parts) => (
        <p set:html={renderInline(parts)} />
      ))}
    </section>
  ))}
</article>

<style>
.about-stats {
  display: grid;
