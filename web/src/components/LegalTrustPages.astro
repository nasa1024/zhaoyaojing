          heading: 'Supported Platforms & Scope Limits',
          paragraphs: [
            ['AICheck365 maintains field mappings and sample-backed guides for ', tLink('Gemini', localHref('/platforms/gemini/')), ', ', tLink('DALL-E / GPT Image', localHref('/platforms/dall-e/')), ', ', tLink('Adobe Firefly', localHref('/platforms/firefly/')), ', ', tLink('Midjourney', localHref('/platforms/midjourney/')), ', ', tLink('Stable Diffusion', localHref('/platforms/stable-diffusion/')), ', ', tLink('ComfyUI', localHref('/platforms/comfyui/')), ', ', tLink('Flux', localHref('/platforms/flux/')), ', ', tLink('Sora', localHref('/platforms/sora/')), ', ', tLink('Kling', localHref('/platforms/kling/')), ', and ', tLink('Runway', localHref('/platforms/runway/')), '.'],
