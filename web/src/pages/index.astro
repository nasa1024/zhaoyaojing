---
import Base from '../layouts/Base.astro';
import Detector from '../components/Detector.astro';
import FileAnatomy from '../components/FileAnatomy.astro';
import EvidenceVanish from '../components/EvidenceVanish.astro';
import FiveLayer from '../components/FiveLayer.astro';
import PlatformFingerprint from '../components/PlatformFingerprint.astro';
import MethodologyBlock from '../components/MethodologyBlock.astro';
import SampleExperience from '../components/SampleExperience.astro';
