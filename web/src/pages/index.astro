  platformsLink: '平台檢測指南',
  videoGuideLink: 'AI 影片檢測指南',
};

const copy = homeCopy[pageLang] ?? homeCopy.en;
const faqJsonLd = copy.faq
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": copy.faq.items.map(([question, answer]) => ({
        "@type": "Question",
        "name": question,
        "acceptedAnswer": { "@type": "Answer", "text": answer },
      })),
    }
  : null;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "AICheck365",
  "url": "https://www.aicheck365.com/",
  "description": copy.description,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Web Browser",
  "browserRequirements": "Requires a modern browser with WebAssembly and JavaScript enabled",
  "isAccessibleForFree": true,
  "inLanguage": ["zh-CN", "zh-TW", "en", "ja", "ko", "de", "fr", "es", "pt-BR"],
  "dateModified": "2026-07-10",
  "creator": { "@type": "Organization", "name": "AICheck365", "url": "https://www.aicheck365.com" },
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "featureList": [
    "AI image/video origin signals",
    "EXIF, XMP, C2PA, PNG text chunks, MP4/MOV metadata",
    "Local video frame watermark analysis when metadata is not enough",
    "Runs in the browser without uploading images or videos",
    "Signals for Gemini, Imagen, DALL-E, Midjourney, Stable Diffusion, Firefly, Sora, Kling and more"
  ]
};
---

<Base
  title={copy.title}
  description={copy.description}
  canonical="https://www.aicheck365.com/"
  jsonLd={faqJsonLd ? [jsonLd, faqJsonLd] : jsonLd}
>
  <main class="page">
    <section class="hero card">
      <div class="eyebrow" data-i18n="eyebrow">{copy.eyebrow}</div>
      <div class="hero-layout">
        <div>
          <h1 data-i18n="hero.h1">{copy.h1}</h1>
          <p class="lead" data-i18n-html="hero.lead" set:html={copy.lead} />
          <div class="hero-actions">
            <p class="hero-privacy" data-i18n="hero.privacy">{copy.heroPrivacy ?? homeCopy.en.heroPrivacy}</p>
            <div class="hero-cta">
              <a href="#upload-zone" class="btn-primary" data-i18n="hero.cta.primary">{copy.ctaPrimary ?? homeCopy.en.ctaPrimary}</a>
              <button id="open-sample" class="btn-secondary" data-i18n="hero.cta.secondary">{copy.ctaSecondary ?? homeCopy.en.ctaSecondary}</button>
            </div>
          </div>
        </div>
        <HeroVisual />
      </div>

      <ul class="trust-list">
        <li>
          <strong data-i18n="trust.privacy">{copy.privacy}</strong>
          <span data-i18n="trust.privacy.desc">{copy.privacyDesc}</span>
        </li>
        <li>
          <strong data-i18n="trust.original">{copy.original}</strong>
          <span data-i18n="trust.original.desc">{copy.originalDesc}</span>
        </li>
        <li>
          <strong data-i18n="trust.explain">{copy.explain}</strong>
          <span data-i18n="trust.explain.desc">{copy.explainDesc}</span>
        </li>
      </ul>

      <div class="notice warning" data-i18n-html="notice" set:html={copy.notice} />
    </section>

    <section class="card content-section file-anatomy-section">
      <FileAnatomy />
    </section>

    <Detector />

    <EvidenceVanish />

    <FiveLayer />

    <PlatformFingerprint prefix={prefix} />

    <section class="card content-section">
      <h2>{copy.seoTitle}</h2>
      <p set:html={copy.seoP1} />
      <p>{copy.seoP2}</p>
      <p><a href={`${prefix}/platforms/`}>{copy.platformsLink}</a> · <a href={`${prefix}/blog/how-to-detect-ai-videos/`}>{copy.videoGuideLink}</a></p>
      <h3>{copy.usageTitle}</h3>
      <ul class="content-list">
        {copy.usage.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    {copy.article && (
      <section class="card content-section">
        <h2>{copy.article.title}</h2>
        {copy.article.sections.map((section) => (
          <>
            {section.heading && <h3>{section.heading}</h3>}
            {(section.paragraphs ?? []).map((paragraph) => <p set:html={paragraph} />)}
            {section.list && (
              <ul class="content-list">
                {section.list.map((item) => <li set:html={item} />)}
              </ul>
            )}
            {section.ordered && (
              <ol class="content-list">
                {section.ordered.map((item) => <li set:html={item} />)}
              </ol>
            )}
            {(section.closing ?? []).map((paragraph) => <p set:html={paragraph} />)}
          </>
        ))}
        {copy.article.cta && (
          <div class="hero-cta">
            <a href="#upload-zone" class="btn-primary">{copy.article.cta}</a>
          </div>
        )}
      </section>
    )}

    {copy.faq && (
      <section class="card content-section">
        <h2>{copy.faq.title}</h2>
        <div class="faq-list">
          {copy.faq.items.map(([question, answer]) => (
            <details class="faq-item">
              <summary>{question}</summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <MethodologyBlock />

    <div class="ad-slot ad-slot--after-methodology" data-ad-placement="after-methodology">
      <span class="ad-label" style="display:block;font-size:11px;text-transform:uppercase;letter-spacing:.08em;opacity:.55;margin-bottom:6px">{adLabel}</span>
      <!-- Replace after AdSense approval:
      <ins class="adsbygoogle"
           style="display:block"
           data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
           data-ad-slot="XXXXXXXXXX"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
      <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
      -->
    </div>

    <SampleExperience />

    <LatestExperiments />

    <script type="module" src="/scripts/scroll-narrative.js"></script>
  </main>
</Base>
