---
import UnifiedToolPage from '../../../components/tools/UnifiedToolPage.astro';

export function getStaticPaths() {
  const langs = ['zh-TW', 'en', 'ja', 'ko', 'de'];
  const tools = ['exif-xmp-reader', 'png-parameter-extractor', 'mp4-metadata-inspector'];
  return langs.flatMap((lang) => tools.map((tool) => ({ params: { lang, tool } })));
}
---
<UnifiedToolPage />
