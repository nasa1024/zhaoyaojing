---
import HomePage from '../index.astro';
import AboutPage from '../about.astro';
import PlatformsPage from '../platforms/index.astro';
import DallEPage from '../platforms/dall-e.astro';
import GeminiPage from '../platforms/gemini.astro';
import ImagenPage from '../platforms/imagen.astro';
import FireflyPage from '../platforms/firefly.astro';
import KlingPage from '../platforms/kling.astro';
import MidjourneyPage from '../platforms/midjourney.astro';
import StableDiffusionPage from '../platforms/stable-diffusion.astro';

const routes = [
  { path: undefined, component: HomePage },
  { path: 'about', component: AboutPage },
  { path: 'platforms', component: PlatformsPage },
  { path: 'platforms/dall-e', component: DallEPage },
  { path: 'platforms/gemini', component: GeminiPage },
  { path: 'platforms/imagen', component: ImagenPage },
  { path: 'platforms/firefly', component: FireflyPage },
  { path: 'platforms/kling', component: KlingPage },
  { path: 'platforms/midjourney', component: MidjourneyPage },
  { path: 'platforms/stable-diffusion', component: StableDiffusionPage },
];

export function getStaticPaths() {
  const supportedLangs = ['zh-CN', 'zh-TW', 'en', 'ja', 'ko', 'de', 'fr', 'es', 'pt-BR'];
  const paths = [
    undefined,
    'about',
    'platforms',
    'platforms/dall-e',
    'platforms/gemini',
    'platforms/imagen',
    'platforms/firefly',
    'platforms/kling',
    'platforms/midjourney',
    'platforms/stable-diffusion',
  ];

  return supportedLangs.flatMap((lang) =>
    paths.map((path) => ({
      params: { lang, path },
    }))
  );
}

const route = routes.find(({ path }) => path === Astro.params.path);
const Page = route?.component ?? HomePage;
---

<Page />
