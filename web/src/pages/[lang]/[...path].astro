---
import HomePage from '../index.astro';
import LocalizedContentPage from '../../components/LocalizedContentPage.astro';

export function getStaticPaths() {
  const supportedLangs = ['zh-TW', 'en', 'ja', 'ko', 'de', 'fr', 'es', 'pt-BR'];
  const paths = [
    'about',
    'blog',
    'blog/ai-image-metadata-guide',
    'blog/how-to-detect-ai-images',
    'blog/how-to-detect-ai-videos',
    'blog/how-to-detect-gemini-generated-images',
    'blog/what-is-c2pa',
    'contact',
    'privacy',
    'terms',
    'platforms',
    'platforms/comfyui',
    'platforms/dall-e',
    'platforms/flux',
    'platforms/gemini',
    'platforms/ideogram',
    'platforms/imagen',
    'platforms/firefly',
    'platforms/kling',
    'platforms/leonardo',
    'platforms/midjourney',
    'platforms/sora',
    'platforms/stable-diffusion',
    'platforms/runway',
  ];
  const explicitRoutes = new Set(['en:', 'de:', 'en:blog', 'zh-TW:blog']);

  return supportedLangs.flatMap((lang) =>
    [undefined, ...paths]
      .filter((path) => !explicitRoutes.has(`${lang}:${path ?? ''}`))
      .map((path) => ({ params: { lang, path } }))
  );
}

const lang = Astro.params.lang ?? 'en';
const pagePath = Astro.params.path;
---

{pagePath ? <LocalizedContentPage lang={lang} pagePath={pagePath} /> : <HomePage />}
