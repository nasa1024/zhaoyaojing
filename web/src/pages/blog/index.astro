---
import Base from '../../layouts/Base.astro';

const articles = [
  {
    slug: 'how-to-detect-ai-videos',
    title: '如何检测 AI 生成视频？容器元数据、SEI marker 与帧水印逐层排查',
    desc: '从 MP4 box 树到码流 SEI，再到角标和隐形水印：Sora、可灵、Runway、Veo 等平台的视频各在哪一层留了痕迹，转码又会洗掉什么。',
    date: '2026-06',
    tags: ['AI 视频', 'MP4', 'C2PA'],
  },
  {
    slug: 'how-to-detect-gemini-generated-images',
    title: '如何检测 Gemini 生成的图片和视频？C2PA、XMP Credit 与 SynthID 详解',
    desc: '用真实 Gemini 原图拆解 PNG caBX chunk 里的 C2PA manifest、Made with Google AI 署名，以及为什么第三方读不了 SynthID。',
    date: '2026-06',
    tags: ['Gemini', 'C2PA'],
  },
  {
    slug: 'how-to-detect-ai-images',
    title: '如何判断一张图片是否 AI 生成？元数据、视觉特征与分类器实战',
    desc: '按"先查文件、再看画面、最后交叉验证"的顺序排查，讲清每种方法的可信边界：有信号约等于实锤，没信号不等于清白。',
    date: '2026-06',
    tags: ['检测方法', 'AI 图片'],
  },
  {
    slug: 'what-is-c2pa',
    title: 'C2PA 是什么？AI 图片/视频溯源标准完整解读',
    desc: '从 JUMBF 容器、manifest 结构到 COSE 签名和 digitalSourceType 词表，以及它在 JPEG APP11、PNG caBX chunk 里的存放细节。',
    date: '2026-06',
    tags: ['C2PA', '标准'],
  },
  {
    slug: 'ai-image-metadata-guide',
    title: 'AI 媒体元数据完整指南：EXIF、XMP、C2PA、PNG tEXt、MP4',
    desc: '逐字节拆解各平台写入的元数据：UserComment 里的 AIGC JSON、A1111 的 parameters 块、MP4 ilst 工具字段和 ContentProducer 编码。',
    date: '2026-06',
    tags: ['元数据', 'EXIF', 'XMP'],
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.aicheck365.com/" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://www.aicheck365.com/blog/" },
    ]
  }
];
---

<Base
  title="AI 图片/视频检测知识库 | AICheck365 Blog"
  description="AICheck365 知识库：记录 AI 图片和视频检测方法、Gemini C2PA 案例、MP4 元数据、Content Credentials 字段和常见平台线索。"
  canonical="https://www.aicheck365.com/blog/"
  jsonLd={jsonLd}
>
  <main class="page content-page">
    <div class="content-hero card">
      <h1>AI 图片/视频检测知识库</h1>
      <p class="lead-text">这里记录一些实际会用到的检测方法：看图片元数据、看视频容器、看 C2PA、看平台留下的字段，也说明这些方法的边界。</p>
    </div>

    <div class="blog-grid">
      {articles.map(a => (
        <a href={`/blog/${a.slug}/`} class="blog-card card">
          <div class="tag-row">
            {a.tags.map(t => <span class="tag-inline">{t}</span>)}
          </div>
          <h2>{a.title}</h2>
          <p class="muted">{a.desc}</p>
          <span class="blog-meta">{a.date} · AICheck365</span>
        </a>
      ))}
    </div>
  </main>
</Base>
