---
import Base from '../../layouts/Base.astro';

const articles = [
  {
    slug: 'how-to-detect-gemini-generated-images',
    title: '如何通过 C2PA 元数据检测 Gemini 生成图片？',
    desc: '用一张真实 Gemini 原图解释 C2PA、PNG caBX/JUMBF 和 trainedAlgorithmicMedia。',
    date: '2026-05',
    tags: ['Gemini', 'C2PA'],
  },
  {
    slug: 'how-to-detect-ai-images',
    title: '如何判断一张图片是否 AI 生成？先看这些线索',
    desc: '先查元数据，再看上下文。也说明为什么有些图片查不出来。',
    date: '2025-05',
    tags: ['检测方法', 'AI 图片'],
  },
  {
    slug: 'what-is-c2pa',
    title: 'C2PA 是什么？它在 AI 图片里记录了什么',
    desc: '解释 C2PA、Content Credentials、claim 和来源字段的关系。',
    date: '2025-04',
    tags: ['C2PA', '标准'],
  },
  {
    slug: 'ai-image-metadata-guide',
    title: 'AI 图片元数据：EXIF、XMP、C2PA、PNG tEXt',
    desc: '整理常见图片元数据格式，以及 AI 工具可能写进去的内容。',
    date: '2025-04',
    tags: ['元数据', 'EXIF', 'XMP'],
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://aicheck365.com/" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://aicheck365.com/blog/" },
    ]
  }
];
---

<Base
  title="AI 图片检测笔记 | AICheck365 Blog"
  description="AICheck365 知识库：记录 AI 图片检测方法、Gemini C2PA 案例、Content Credentials 字段和常见平台线索。"
  canonical="https://aicheck365.com/blog/"
  jsonLd={jsonLd}
>
  <main class="page content-page">
    <div class="content-hero card">
      <h1>AI 图片检测笔记</h1>
      <p class="lead-text">这里记录一些实际会用到的检测方法：看元数据、看 C2PA、看平台留下的字段，也说明这些方法的边界。</p>
    </div>

    <div class="blog-grid">
      {articles.map(a => (
        <a href={`/blog/${a.slug}/`} class="blog-card card">
          <div class="tag-row">
            {a.tags.map(t => <span class="tag-inline">{t}</span>)}
          </div>
          <h2>{a.title}</h2>
          <p class="muted">{a.desc}</p>
          <span class="blog-meta">{a.date} · AICheck365</span>
        </a>
      ))}
    </div>
  </main>
</Base>
