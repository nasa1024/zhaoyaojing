---
import Base from '../../layouts/Base.astro';

const faq = [
  { q: "AI 生成视频一定能检测出来吗？", a: "不能保证。检测依赖原始文件里保留的 C2PA、MP4/MOV 元数据、SEI marker、文件名或视频帧水印。转码、录屏、剪辑软件重新导出后，这些线索可能消失。" },
  { q: "为什么优先上传原始视频？", a: "原始视频最可能保留容器元数据和内容凭证。社交平台会重新编码视频，常常删除或覆盖来源字段。" },
  { q: "浏览器版会上传视频吗？", a: "不会。视频文件在本地浏览器内读取；只有 ffmpeg.wasm 和检测 WASM 在本机处理文件字节和抽样帧。" },
  { q: "C2PA-lite 和完整 C2PA 验证有什么区别？", a: "浏览器版会扫描 C2PA/JUMBF 中的来源文本和 AI 工具线索，但不做完整签名链和证书链验证。它适合快速判断，不等同于法证审计。" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://aicheck365.com/" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://aicheck365.com/blog/" },
      { "@type": "ListItem", "position": 3, "name": "如何检测 AI 视频", "item": "https://aicheck365.com/blog/how-to-detect-ai-videos/" },
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "如何检测 AI 生成视频？MP4 元数据、C2PA 与视频帧水印指南",
    "description": "解释 Sora、可灵、Runway、Pika 等 AI 视频可能留下的 C2PA-lite、MP4/MOV 元数据、SEI marker、文件名和视频帧水印线索。",
    "url": "https://aicheck365.com/blog/how-to-detect-ai-videos/",
    "publisher": { "@type": "Organization", "name": "AICheck365", "url": "https://aicheck365.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faq.map(item => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": { "@type": "Answer", "text": item.a }
    }))
  }
];
---

<Base
  title="如何检测 AI 生成视频？MP4 元数据、C2PA 与帧水印 | AICheck365"
  description="上传原始 AI 视频，在浏览器本地检查 C2PA-lite、MP4/MOV 元数据、SEI marker、文件名和抽样视频帧水印线索。"
  canonical="https://aicheck365.com/blog/how-to-detect-ai-videos/"
  jsonLd={jsonLd}
>
  <main class="page content-page">
    <nav class="breadcrumb">
      <a href="/">首页</a> › <a href="/blog/">知识库</a> › 如何检测 AI 视频
    </nav>

    <article class="card content-article">
      <h1>如何检测 AI 生成视频？MP4 元数据、C2PA 与视频帧水印指南</h1>
      <p class="article-meta">2026年5月 · AI 视频检测 · MP4 元数据 · C2PA</p>

      <p class="lead-text">AI 视频检测不能只看画面。Sora、可灵、Runway、Pika、Veo、Vidu、Luma、海螺、Pixverse、Wan 等工具导出的原始视频，可能在容器元数据、C2PA/JUMBF、SEI marker、文件名或视频帧水印里留下来源线索。</p>

      <h2>第一步：优先使用原始视频文件</h2>
      <p>最适合检测的是从生成平台直接下载的 MP4、MOV、M4V、WebM 或 AVI 文件。转发到社交平台、录屏、剪辑后重新导出的视频，通常会被重新编码，原始元数据和水印线索都可能减少。</p>

      <h2>浏览器版会检查哪些视频信号？</h2>
      <div class="signal-detail-grid">
        <div class="signal-detail-card">
          <h3>C2PA-lite / JUMBF</h3>
          <p>扫描视频容器中的 C2PA、Content Credentials、digitalSourceType、claim_generator 等来源文本。</p>
        </div>
        <div class="signal-detail-card">
          <h3>MP4 / MOV 元数据</h3>
          <p>检查工具名、AIGC 标签、ContentProducer、iTunes 风格原子和其他可读容器字段。</p>
        </div>
        <div class="signal-detail-card">
          <h3>SEI marker</h3>
          <p>部分 H.264/MP4 视频可能在编码流里保留 Sora、Kling、Runway、Pika 等工具标记。</p>
        </div>
        <div class="signal-detail-card">
          <h3>抽样视频帧水印</h3>
          <p>如果元数据没有命中，页面会懒加载 ffmpeg.wasm，抽取少量帧做隐形水印和可见水印分析。</p>
        </div>
      </div>

      <h2>检测结果怎么理解？</h2>
      <ul class="content-list">
        <li><strong>有 C2PA 或明确工具名</strong>：通常是强来源线索，但浏览器版不做完整签名链验证。</li>
        <li><strong>只有文件名或低置信度水印</strong>：只能作为辅助判断，需要结合来源上下文。</li>
        <li><strong>没有检测到信号</strong>：不等于视频一定不是 AI 生成，只表示当前文件没有可读线索。</li>
      </ul>

      <h2>隐私和性能</h2>
      <p>视频文件不会上传服务器。浏览器会在本地读取文件字节，并在需要时用 ffmpeg.wasm 抽取帧。大文件或长视频可能会比较慢，建议优先用原始短片或平台导出的原始文件测试。</p>

      <div class="cta-box">
        <p>上传原始 AI 视频，检查 MP4 元数据、C2PA 和视频帧水印</p>
        <a href="/" class="primary" style="display:inline-block;text-decoration:none;padding:12px 28px;">开始检测 →</a>
      </div>

      <h2>常见问题</h2>
      <div class="faq-list">
        {faq.map(item => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </article>

    <div class="related-platforms card">
      <h2>相关内容</h2>
      <div class="related-links">
        <a href="/platforms/sora/">Sora 视频怎么查 →</a>
        <a href="/platforms/kling/">可灵 Kling 视频怎么查 →</a>
        <a href="/blog/what-is-c2pa/">C2PA 是什么 →</a>
        <a href="/blog/ai-image-metadata-guide/">媒体元数据指南 →</a>
      </div>
    </div>
  </main>
</Base>
