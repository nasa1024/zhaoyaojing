const baseCopy = COPY[pageLang] ?? COPY.en;
const pageUrl = `https://www.aicheck365.com${navPrefix}/methodology/`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: baseCopy.h1,
    description: baseCopy.description,
    url: pageUrl,
    dateModified: '2026-06-21',
    author: {
      '@type': 'Organization',
      name: 'AICheck365',
      url: 'https://www.aicheck365.com',
    },
    publisher: {
      '@type': 'Organization',
      name: 'AICheck365',
      url: 'https://www.aicheck365.com',
      logo: {
        '@type': 'ImageObject',
        url: 'https://www.aicheck365.com/og.png',
      },
    },
    inLanguage: pageLang,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: baseCopy.homeLabel,
        item: `https://www.aicheck365.com${navPrefix ? navPrefix + '/' : '/'}`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: baseCopy.h1,
        item: pageUrl,
      },
    ],
  },
];
---

<Base
  title={baseCopy.title}
  description={baseCopy.description}
  canonical={pageUrl}
  jsonLd={jsonLd}
>
  <main class="page content-page">
    <article class="card content-article">
      <nav class="breadcrumb" aria-label="breadcrumb">
        <a href={navPrefix ? `${navPrefix}/` : '/'}>{baseCopy.homeLabel}</a>
        <span aria-hidden="true"> › </span>
        <span>{baseCopy.h1}</span>
      </nav>

      <h1>{baseCopy.h1}</h1>

      <p class="lead-text">{baseCopy.lead}</p>

      <div class="methodology-grid">
        <section class="methodology-col methodology-col--can">
          <h2>{baseCopy.canCheckHeading}</h2>
          <ul class="content-list methodology-list">
            {baseCopy.canCheck.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section class="methodology-col methodology-col--cannot">
          <h2>{baseCopy.cannotHeading}</h2>
          <ul class="content-list methodology-list">
            {baseCopy.cannot.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      </div>

      <blockquote class="methodology-slogan-block">
        <p class="methodology-slogan">{baseCopy.slogan}</p>
      </blockquote>

      <h2>{baseCopy.linksHeading}</h2>
      <ul class="content-list">
        <li>
          <a href={navPrefix ? `${navPrefix}/` : '/'}>{baseCopy.detectorLabel}</a>
          {' — '}{baseCopy.detectorDesc}
        </li>
        <li>
          <a href={`${navPrefix}/platforms/`}>{baseCopy.platformsLabel}</a>
          {' — '}{baseCopy.platformsDesc}
        </li>
        <li>
          <a href={`${navPrefix}/privacy/`}>{baseCopy.privacyLabel}</a>
          {' — '}{baseCopy.privacyDesc}
        </li>
      </ul>
    </article>
  </main>
</Base>

<style>
.breadcrumb {
  font-size: 13px;
  color: var(--muted);
  margin-bottom: 18px;
}
.breadcrumb a {
  color: var(--muted);
  text-decoration: none;
}
.breadcrumb a:hover {
  color: var(--accent);
  text-decoration: underline;
}

.methodology-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  margin: 28px 0;
}

@media (max-width: 680px) {
  .methodology-grid {
    grid-template-columns: 1fr;
  }
}

.methodology-col {
  padding: 20px 22px;
  border-radius: 14px;
  border: 1px solid var(--border);
}

.methodology-col--can {
  background: rgba(74, 222, 128, 0.06);
  border-color: rgba(74, 222, 128, 0.25);
}

.methodology-col--cannot {
  background: rgba(248, 113, 113, 0.06);
  border-color: rgba(248, 113, 113, 0.25);
}

.methodology-col h2 {
  margin-top: 0;
  font-size: 17px;
}

.methodology-slogan-block {
  margin: 32px 0 24px;
  padding: 18px 24px;
  border-left: 4px solid var(--accent);
  border-radius: 0 10px 10px 0;
  background: rgba(110, 168, 255, 0.07);
}

.methodology-slogan {
  font-size: 18px;
  font-weight: 600;
  font-style: italic;
  color: var(--text);
  margin: 0;
}
</style>
