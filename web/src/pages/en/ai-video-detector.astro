---
import Base from '../../layouts/Base.astro';
import Detector from '../../components/Detector.astro';

// Dedicated landing page for the "ai video detector" query family (Semrush US,
// 2026-09: 1.9K/mo at KD 15, plus "free ai video detector" and
// "ai video detector online free"). It embeds the same local detector as the
// homepage but leads with video evidence, so the page matches a tool intent
// instead of sending searchers to an article first.
const SITE_URL = 'https://www.aicheck365.com';
const canonical = `${SITE_URL}/en/ai-video-detector/`;
const updatedAt = '2026-09-24';

const title = 'Free AI Video Detector: Check MP4 & MOV Files Online | AICheck365';
const description = 'Free AI video detector that runs in your browser: check MP4/MOV files for C2PA credentials, Sora, Veo, Kling and Runway metadata, and frame watermarks. No upload.';

const signals = [
  ['C2PA Content Credentials', 'Signed manifests in MP4/MOV (for example Google Veo) that declare digitalSourceType = trainedAlgorithmicMedia. The strongest evidence when the signature validates.'],
  ['Container metadata', 'ftyp brand, udta/meta/ilst, encoder, ©too and software fields, AIGC labels and platform strings written by generators or their export pipelines.'],
  ['SEI markers', 'Tool strings inside the H.264/H.265 bitstream that can survive a remux but usually not a re-encode.'],
  ['Frame watermarks', 'When the container has nothing to say, frames from several timestamps are checked for visible corner watermarks and invisible watermark patterns. Decoded locally with ffmpeg.wasm.'],
];

const platforms = [
  ['/en/platforms/sora/', 'OpenAI Sora', 'C2PA and MP4 metadata on original downloads; a visible corner watermark on many exports, which the frame check can flag.'],
  ['/en/platforms/kling/', 'Kling AI', 'Container tool fields and frame marks on original MP4 files.'],
  ['/en/platforms/runway/', 'Runway', 'Encoder and container metadata; frame checks when fields are stripped.'],
  ['/en/blog/how-to-detect-ai-videos/', 'Google Veo', 'Signed Google Generative AI C2PA manifest, verified on a real Veo MP4 sample.'],
];

const steps = [
  ['Use the original file', 'Download the MP4 or MOV straight from the generator or the person who made it. Screen recordings and social-media re-downloads usually lose the evidence.'],
  ['Drop it into the detector above', 'Parsing runs in your browser. The video is not uploaded to a server.'],
  ['Read the evidence layer by layer', 'Check the C2PA state first, then container fields with the box path they came from, then SEI and frame results.'],
  ['Interpret an empty result carefully', 'No signal means this copy carries no readable evidence. It does not prove the video was filmed by a person.'],
];

const faq = [
  ['Is this AI video detector free?', 'Yes. It is free, needs no account, and has no upload limit because the file is analyzed on your own device.'],
  ['How do I tell if a video is AI generated?', 'Start from the original MP4 or MOV. Check for a valid C2PA manifest that declares AI generation, then container fields and SEI markers left by the generator, then known frame watermarks. Visual inspection alone is no longer reliable for current video models.'],
  ['Can it detect Sora, Veo, Kling and Runway videos?', 'It recognizes the provenance signals these tools currently write — C2PA manifests, container metadata and known watermarks — when they are still present in the file. It is not a general classifier that guesses from pixels.'],
  ['Does it work on TikTok, YouTube or Instagram downloads?', 'Sometimes a watermark or file-name clue survives, but these platforms re-encode uploads and usually strip C2PA and container metadata. For a reliable answer, find the first published or original file.'],
  ['Is my video uploaded?', 'No. The container is parsed with WebAssembly in your browser, and frame extraction, when needed, also runs locally.'],
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'AICheck365 AI Video Detector',
    url: canonical,
    description,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Web browser',
    browserRequirements: 'Modern browser with WebAssembly and JavaScript',
    isAccessibleForFree: true,
    inLanguage: 'en',
    dateModified: updatedAt,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: ['C2PA video Content Credentials', 'MP4/MOV container metadata', 'SEI marker scan', 'Frame watermark fallback', 'Local browser processing'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(([question, answer]) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/en/` },
      { '@type': 'ListItem', position: 2, name: 'AI Video Detector', item: canonical },
    ],
  },
];
---

<Base title={title} description={description} canonical={canonical} lang="en" jsonLd={jsonLd} alternateLangs={['en']}>
  <main class="page">
    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href="/en/">Home</a>
      <span aria-hidden="true"> › </span>
      <span>AI Video Detector</span>
    </nav>

    <section class="hero card priority-seo-page" data-seo-intent="transactional-tool" data-tool-owner="ai-video-detector">
      <div class="eyebrow">Free · No upload · MP4 / MOV / WebM</div>
      <h1>Free AI Video Detector: check if a video is AI generated</h1>
      <p class="lead">
        Drop an original video file to check it for AI provenance evidence: C2PA Content Credentials, generator
        metadata from Sora, Veo, Kling and Runway, SEI markers, and known frame watermarks. Everything runs locally
        in your browser, and every match shows the exact field it came from.
      </p>
      <div class="notice warning">
        <strong>Best with original files.</strong> Screen recordings and videos re-downloaded from social media
        usually lose their metadata. No signal found is not the same as “not AI-generated.”
      </div>
    </section>

    <Detector />

    <article class="card content-article">
      <h2>What the AI video detector checks</h2>
      <table class="tool-glossary">
        <tbody>
          {signals.map(([label, value]) => <tr><th>{label}</th><td>{value}</td></tr>)}
        </tbody>
      </table>

      <h2>How to tell if a video is AI generated</h2>
      <ol class="content-list">
        {steps.map(([label, value]) => <li><strong>{label}:</strong> {value}</li>)}
      </ol>
      <p>
        Want the full method with real samples? Read the
        <a href="/en/blog/how-to-detect-ai-videos/">guide to telling if a video is AI generated</a>, or inspect the raw
        container with the <a href="/en/tools/mp4-metadata-inspector/">MP4/MOV metadata inspector</a>.
      </p>

      <h2>Video generators and the evidence they leave</h2>
      <table class="tool-glossary">
        <tbody>
          {platforms.map(([href, label, value]) => <tr><th><a href={href}>{label}</a></th><td>{value}</td></tr>)}
        </tbody>
      </table>

      <h2>Why this is not a “deepfake score”</h2>
      <p>
        Pixel classifiers return a probability that is hard to explain and easy to fool with re-encoding. AICheck365
        reports only evidence stored in the file — a signed manifest, a metadata field, a known watermark — so you can
        see why a result was reached and verify it yourself. The trade-off is honesty about gaps: when a platform strips
        the evidence, the detector says so instead of guessing.
      </p>

      <h2>FAQ</h2>
      <dl class="faq-list">
        {faq.map(([question, answer]) => (
          <div class="faq-item"><dt>{question}</dt><dd><p>{answer}</p></dd></div>
        ))}
      </dl>

      <h2>Related tools and guides</h2>
      <div class="related-links">
        <a href="/en/tools/c2pa-validator/">Validate a video’s C2PA manifest →</a>
        <a href="/en/tools/mp4-metadata-inspector/">Inspect MP4/MOV metadata →</a>
        <a href="/en/blog/how-to-detect-ai-videos/">How to tell if a video is AI generated →</a>
        <a href="/en/">AI image and video detector →</a>
      </div>
    </article>
  </main>
</Base>

<script type="module" src="/scripts/market-analytics.js"></script>
