---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page Not Found | 页面未找到 | AICheck365"
  description="The requested page does not exist. / 您请求的页面不存在。"
  canonical="https://www.aicheck365.com/404/"
  robots="noindex, follow"
  singleLang={true}
>
  <main class="page content-page">
    <div class="card not-found-card" style="text-align: center; padding: 48px 24px;">
      <h1 style="font-size: 72px; margin-bottom: 12px; color: var(--text);">404</h1>
      <p style="font-size: 20px; font-weight: 600; margin-bottom: 8px;">Page Not Found / 页面未找到</p>
      <p class="muted" style="margin-bottom: 24px; font-size: 14px;">The requested page does not exist. / 您请求的页面不存在。</p>
      <a href="/" class="primary" style="display:inline-block;text-decoration:none;padding:12px 28px;">Go Home / 返回首页</a>
    </div>
  </main>
</Base>
