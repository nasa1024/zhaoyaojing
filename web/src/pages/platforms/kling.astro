---
import Base from '../../layouts/Base.astro';

const faq = [
  { q: "可灵生成的图片和视频可以被检测到吗？", a: "可以检测一部分原始文件。图片侧重点是 XMP、EXIF 和文件名；视频侧重点是 MP4/MOV 容器元数据、SEI marker、文件名和抽样视频帧水印。" },
  { q: "可灵视频现在支持直接上传检测吗？", a: "支持。AICheck365 浏览器版可以直接选择 MP4、MOV、M4V、WebM、AVI 等视频文件，检测过程在本地浏览器完成，不上传服务器。" },
  { q: "可灵视频为什么可能检测不到？", a: "如果视频经过平台转码、录屏、剪辑软件重新导出或清理元数据，容器标记和水印线索都可能消失。没有信号不等于一定不是 AI 生成。" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.aicheck365.com/" },
      { "@type": "ListItem", "position": 2, "name": "Platform Guides", "item": "https://www.aicheck365.com/platforms/" },
      { "@type": "ListItem", "position": 3, "name": "可灵 Kling", "item": "https://www.aicheck365.com/platforms/kling/" },
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "可灵 Kling AI 图片/视频检测：MP4 元数据、SEI 标记与帧水印",
    "description": "了解快手可灵（Kling）AI 生成图片和视频的来源线索，以及如何使用 AICheck365 检查 XMP、EXIF、MP4 元数据、SEI marker 和视频帧水印。",
    "url": "https://www.aicheck365.com/platforms/kling/",
    "publisher": { "@type": "Organization", "name": "AICheck365", "url": "https://www.aicheck365.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faq.map(item => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": { "@type": "Answer", "text": item.a }
    }))
  }
];
---

<Base
  title="可灵 Kling AI 图片/视频检测：MP4 元数据与帧水印 | AICheck365"
  description="检测可灵 Kling 原始图片和视频：浏览器本地检查 XMP、EXIF、MP4/MOV 元数据、SEI marker、文件名和视频帧水印。"
  canonical="https://www.aicheck365.com/platforms/kling/"
  jsonLd={jsonLd}
>
  <main class="page content-page">
    <nav class="breadcrumb">
      <a href="/">首页</a> › <a href="/platforms/">平台指南</a> › 可灵 Kling
    </nav>

    <article class="card content-article">
      <h1>可灵（Kling）AI 图片/视频检测</h1>
      <p class="article-meta">信号类型：XMP · EXIF · MP4 元数据 · SEI marker · 视频帧水印</p>

      <p class="lead-text">可灵（Kling）是快手推出的 AI 图片和视频生成平台，以其强大的视频生成能力著称，同时也提供高质量的 AI 图片生成功能。</p>

      <h2>可灵图片和视频的可检测线索</h2>
      <p>可灵生成内容可能包含以下可检测信号：</p>
      <ul class="content-list">
        <li><strong>XMP / EXIF 软件信息</strong>：图片文件可能标注 Kling 相关软件来源</li>
        <li><strong>MP4 / MOV 容器元数据</strong>：视频文件可能保留工具名、AIGC 标签或其他可读来源字段</li>
        <li><strong>SEI marker</strong>：部分视频编码流可能保留可灵相关标记</li>
        <li><strong>视频帧水印</strong>：元数据没有命中时，可抽样少量帧检查隐形或可见水印</li>
        <li><strong>文件名特征</strong>：原始下载文件名可能包含平台或生成工具痕迹</li>
      </ul>

      <h2>图片 vs 视频检测</h2>
      <p>图片通常优先看 XMP、EXIF、PNG 文本块和文件名。视频会先看 C2PA-lite 文本、MP4/MOV/M4V 容器元数据、AIGC 标签、SEI marker 和文件名；如果没有命中，再在浏览器本地抽样视频帧做水印分析。视频越接近原始下载文件，保留线索的概率越高。</p>

      <div class="cta-box">
        <p>立即检测可灵生成的原始图片或视频</p>
        <a href="/" class="primary" style="display:inline-block;text-decoration:none;padding:12px 28px;">开始检测 →</a>
      </div>

      <h2>常见问题</h2>
      <div class="faq-list">
        {faq.map(item => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </article>

    <div class="related-platforms card">
      <h2>其他平台检测指南</h2>
      <div class="related-links">
        <a href="/platforms/midjourney/">Midjourney →</a>
        <a href="/platforms/dall-e/">DALL-E / GPT Image →</a>
        <a href="/platforms/stable-diffusion/">Stable Diffusion →</a>
        <a href="/platforms/firefly/">Adobe Firefly →</a>
      </div>
    </div>
  </main>
</Base>
