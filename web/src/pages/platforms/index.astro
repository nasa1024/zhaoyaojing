---
import Base from '../../layouts/Base.astro';

const platforms = [
  { slug: 'gemini',           name: 'Gemini',              desc: '从 Gemini 下载的原图，常见线索在 C2PA/JUMBF 和 digitalSourceType 里', tags: ['C2PA', 'JUMBF'] },
  { slug: 'imagen',           name: 'Google Imagen',       desc: 'Google 图像生成模型，原图可能保留 Content Credentials 和 Imagen 工具信息', tags: ['C2PA', 'Google AI'] },
  { slug: 'midjourney',       name: 'Midjourney',         desc: '常见于设计图和社交图，部分文件会留下 XMP/IPTC 线索', tags: ['XMP', 'IPTC'] },
  { slug: 'dall-e',           name: 'DALL-E / GPT Image', desc: 'OpenAI 图片可能带 C2PA，原图比转发图更容易判断', tags: ['C2PA', 'XMP'] },
  { slug: 'stable-diffusion', name: 'Stable Diffusion',   desc: '很多生成图会把 prompt、seed 或工具信息写进 PNG 文本块', tags: ['PNG tEXt', 'EXIF'] },
  { slug: 'firefly',          name: 'Adobe Firefly',       desc: 'Adobe 系产品常见 Content Credentials，适合用 C2PA 查来源', tags: ['C2PA', 'XMP'] },
  { slug: 'flux',             name: 'Flux (BFL)',          desc: '不同前端导出的 Flux 图片，保留的元数据差异较大', tags: ['PNG tEXt', 'XMP'] },
  { slug: 'comfyui',          name: 'ComfyUI',             desc: 'PNG 里经常保留 workflow JSON，能看到节点和生成参数', tags: ['PNG tEXt', 'JSON'] },
  { slug: 'leonardo',         name: 'Leonardo AI',         desc: '月活超千万的商业 AI 图片平台，支持 Phoenix 等自研模型', tags: ['XMP', 'EXIF'] },
  { slug: 'ideogram',         name: 'Ideogram',            desc: '常用于海报和文字图，部分文件会留下 XMP 或 EXIF 信息', tags: ['XMP', 'EXIF'] },
  { slug: 'sora',             name: 'Sora (OpenAI)',       desc: 'OpenAI 视频生成内容，原始文件和帧图可能会保留 C2PA 线索', tags: ['C2PA', 'XMP'] },
  { slug: 'kling',            name: '可灵 Kling',           desc: '可灵导出的图片和视频帧，部分文件可能保留 EXIF 或 XMP 线索', tags: ['EXIF', 'XMP'] },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://aicheck365.com/" },
      { "@type": "ListItem", "position": 2, "name": "Platform Guides", "item": "https://aicheck365.com/platforms/" },
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "AI 图片生成平台检测指南",
    "url": "https://aicheck365.com/platforms/",
    "description": "整理常见 AI 图片平台会留下哪些元数据线索，包括 Gemini、Imagen、Midjourney、DALL-E、Stable Diffusion、Adobe Firefly、Flux、ComfyUI、Leonardo AI 等。"
  }
];
---

<Base
  title="AI 图片平台检测指南 | Gemini、Imagen、DALL-E、Midjourney | AICheck365"
  description="查看 Gemini、Imagen、DALL-E、Midjourney、Stable Diffusion、Adobe Firefly、Flux、ComfyUI、Sora 等平台常见的图片元数据线索。"
  canonical="https://aicheck365.com/platforms/"
  jsonLd={jsonLd}
>
  <main class="page content-page">
    <div class="content-hero card">
      <h1>AI 图片平台检测指南</h1>
      <p class="lead-text">不同平台留下的线索不一样。有的写 C2PA，有的写 PNG 参数，也有的几乎什么都不留。这里按平台整理可检查的字段。</p>
    </div>

    <div class="platform-grid">
      {platforms.map(p => (
        <a href={`/platforms/${p.slug}/`} class="platform-card card">
          <div class="platform-card-header">
            <h2>{p.name}</h2>
            <div class="tag-row">
              {p.tags.map(t => <span class="tag-inline">{t}</span>)}
            </div>
          </div>
          <p>{p.desc}</p>
          <span class="card-link">查看可检测线索 →</span>
        </a>
      ))}
    </div>

    <div class="card content-section">
      <h2>为什么不同平台的检测方法不同？</h2>
      <p>平台写入元数据的方式并不统一。OpenAI、Adobe、Google 这类产品更可能使用 C2PA；Stable Diffusion、ComfyUI 这类工作流则取决于用户使用的前端和导出设置。有些平台导出的文件可能没有可读线索。</p>
      <p>所以检测结果只能作为<strong>辅助参考</strong>。没检测到，不代表图片一定不是 AI 生成。</p>
      <p style="margin-top:16px"><a href="/" class="primary" style="display:inline-block;text-decoration:none;padding:12px 24px;">检测一张图片 →</a></p>
    </div>
  </main>
</Base>
