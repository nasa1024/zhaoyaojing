---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: object | object[];
}

const {
  title,
  description,
  canonical = 'https://www.aicheck365.com',
  ogImage = 'https://www.aicheck365.com/og.png',
  jsonLd,
} = Astro.props;

const SITE_URL = 'https://www.aicheck365.com';
const DEFAULT_LANG = 'zh-CN';
const SUPPORTED_LANGS = ['zh-CN', 'zh-TW', 'en', 'ja', 'ko', 'de', 'fr', 'es', 'pt-BR'];
const OG_LOCALE: Record<string, string> = {
  'zh-CN': 'zh_CN',
  'zh-TW': 'zh_TW',
  en: 'en_US',
  ja: 'ja_JP',
  ko: 'ko_KR',
  de: 'de_DE',
  fr: 'fr_FR',
  es: 'es_ES',
  'pt-BR': 'pt_BR',
};
const NAV_LABELS: Record<string, Record<string, string>> = {
  'zh-CN': {
    tool: '检测工具',
    platforms: '平台指南',
    blog: '知识库',
    about: '关于',
    privacy: '隐私政策',
    terms: '服务条款',
    contact: '联系',
    footer: `© ${new Date().getFullYear()} AICheck365 · 图片/视频仅在本地浏览器分析，不上传服务器`,
  },
  'zh-TW': {
    tool: '檢測工具',
    platforms: '平台指南',
    blog: '知識庫',
    about: '關於',
    privacy: '隱私權政策',
    terms: '服務條款',
    contact: '聯絡',
    footer: `© ${new Date().getFullYear()} AICheck365 · 圖片/影片僅在本機瀏覽器分析，不上傳伺服器`,
  },
  en: {
    tool: 'Detector',
    platforms: 'Platform Guides',
    blog: 'Knowledge Base',
    about: 'About',
    privacy: 'Privacy',
    terms: 'Terms',
    contact: 'Contact',
    footer: `© ${new Date().getFullYear()} AICheck365 · Images and videos are analyzed locally in your browser`,
  },
  ja: {
    tool: '検出ツール',
    platforms: 'プラットフォームガイド',
    blog: 'ナレッジベース',
    about: '概要',
    privacy: 'プライバシー',
    terms: '利用規約',
    contact: 'お問い合わせ',
    footer: `© ${new Date().getFullYear()} AICheck365 · 画像と動画はブラウザ内でローカル分析されます`,
  },
  ko: {
    tool: '검사 도구',
    platforms: '플랫폼 가이드',
    blog: '지식 베이스',
    about: '소개',
    privacy: '개인정보',
    terms: '약관',
    contact: '문의',
    footer: `© ${new Date().getFullYear()} AICheck365 · 이미지와 비디오는 브라우저에서 로컬로 분석됩니다`,
  },
  de: {
    tool: 'Detektor',
    platforms: 'Plattform-Guides',
    blog: 'Wissensbasis',
    about: 'Über uns',
    privacy: 'Datenschutz',
    terms: 'Bedingungen',
    contact: 'Kontakt',
    footer: `© ${new Date().getFullYear()} AICheck365 · Bilder und Videos werden lokal im Browser analysiert`,
  },
  fr: {
    tool: 'Détecteur',
    platforms: 'Guides plateformes',
    blog: 'Base de connaissances',
    about: 'À propos',
    privacy: 'Confidentialité',
    terms: 'Conditions',
    contact: 'Contact',
    footer: `© ${new Date().getFullYear()} AICheck365 · Images et vidéos sont analysées localement dans le navigateur`,
  },
  es: {
    tool: 'Detector',
    platforms: 'Guías de plataformas',
    blog: 'Base de conocimiento',
    about: 'Acerca de',
    privacy: 'Privacidad',
    terms: 'Términos',
    contact: 'Contacto',
    footer: `© ${new Date().getFullYear()} AICheck365 · Las imágenes y videos se analizan localmente en el navegador`,
  },
  'pt-BR': {
    tool: 'Detector',
    platforms: 'Guias de plataformas',
    blog: 'Base de conhecimento',
    about: 'Sobre',
    privacy: 'Privacidade',
    terms: 'Termos',
    contact: 'Contato',
    footer: `© ${new Date().getFullYear()} AICheck365 · Imagens e vídeos são analisados localmente no navegador`,
  },
};

function getUrlLang(pathname: string) {
  const segment = pathname.split('/').filter(Boolean)[0];
  return SUPPORTED_LANGS.includes(segment) ? segment : null;
}

function stripLangPrefix(pathname: string) {
  const parts = pathname.split('/').filter(Boolean);
  if (parts.length && SUPPORTED_LANGS.includes(parts[0])) parts.shift();
  return parts.length ? `/${parts.join('/')}/` : '/';
}

function localizedPath(pathname: string, lang: string) {
  const cleanPath = stripLangPrefix(pathname);
  return cleanPath === '/' ? `/${lang}/` : `/${lang}${cleanPath}`;
}

function pathFromCanonical(url: string) {
  try {
    return new URL(url, SITE_URL).pathname;
  } catch {
    return '/';
  }
}

const urlLang = getUrlLang(Astro.url.pathname);
const pageLang = urlLang ?? DEFAULT_LANG;
const canonicalPath = pathFromCanonical(canonical);
const canonicalHref = urlLang
  ? `${SITE_URL}${localizedPath(canonicalPath, pageLang)}`
  : canonical;
const navPrefix = urlLang ? `/${pageLang}` : '';
const homeHref = navPrefix ? `${navPrefix}/` : '/';
const platformsHref = `${navPrefix}/platforms/`;
const aboutHref = `${navPrefix}/about/`;
const i18nPage = canonicalPath === '/' ? 'home' : 'content';
const navLabels = NAV_LABELS[pageLang] ?? NAV_LABELS[DEFAULT_LANG];
---

<!doctype html>
<html lang={pageLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalHref} />
    <link rel="alternate" hreflang="x-default" href={`${SITE_URL}${canonicalPath}`} />
    {SUPPORTED_LANGS.map((lang) => (
      <link rel="alternate" hreflang={lang} href={`${SITE_URL}${localizedPath(canonicalPath, lang)}`} />
    ))}

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalHref} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:site_name"   content="AICheck365" />
    <meta property="og:locale"      content={OG_LOCALE[pageLang] ?? 'zh_CN'} />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <!-- JSON-LD -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(Array.isArray(jsonLd) ? jsonLd : [jsonLd])} />
    )}

    <!-- Google AdSense placeholder -->
    <!-- <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX" crossorigin="anonymous"></script> -->

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-8RF8YQ5YB1"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-8RF8YQ5YB1');
    </script>

    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />

    <link rel="stylesheet" href="/style.css" />
  </head>
  <body data-i18n-page={i18nPage}>
    <header class="site-header">
      <a href={homeHref} class="site-logo">AICheck365</a>
      <nav class="site-nav" id="site-nav">
        <a href={platformsHref} class="nav-link" data-i18n="nav.platforms">{navLabels.platforms}</a>
        <a href={`${navPrefix}/blog/`} class="nav-link" data-i18n="nav.blog">{navLabels.blog}</a>
        <a href={aboutHref} class="nav-link" data-i18n="nav.about">{navLabels.about}</a>
      </nav>
      <select id="lang-switch" class="lang-select" aria-label="Select language">
        <option value="zh-CN" selected={pageLang === 'zh-CN'}>中文（简）</option>
        <option value="zh-TW" selected={pageLang === 'zh-TW'}>中文（繁）</option>
        <option value="en" selected={pageLang === 'en'}>English</option>
        <option value="ja" selected={pageLang === 'ja'}>日本語</option>
        <option value="ko" selected={pageLang === 'ko'}>한국어</option>
        <option value="de" selected={pageLang === 'de'}>Deutsch</option>
        <option value="fr" selected={pageLang === 'fr'}>Français</option>
        <option value="es" selected={pageLang === 'es'}>Español</option>
        <option value="pt-BR" selected={pageLang === 'pt-BR'}>Português</option>
      </select>
      <button id="theme-toggle" class="theme-btn" aria-label="Toggle theme" title="Toggle light/dark theme">☀</button>
      <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </button>
    </header>
    <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
      <a href={homeHref} class="mobile-link" data-i18n="nav.tool">{navLabels.tool}</a>
      <a href={platformsHref} class="mobile-link" data-i18n="nav.platforms">{navLabels.platforms}</a>
      <a href={`${navPrefix}/blog/`} class="mobile-link" data-i18n="nav.blog">{navLabels.blog}</a>
      <a href={aboutHref} class="mobile-link" data-i18n="nav.about">{navLabels.about}</a>
      <a href={`${navPrefix}/privacy/`} class="mobile-link" data-i18n="nav.privacy">{navLabels.privacy}</a>
      <a href={`${navPrefix}/contact/`} class="mobile-link" data-i18n="nav.contact">{navLabels.contact}</a>
    </div>

    <slot />

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-links">
          <a href={homeHref} data-i18n="nav.tool">{navLabels.tool}</a>
          <a href={platformsHref} data-i18n="nav.platforms">{navLabels.platforms}</a>
          <a href={aboutHref} data-i18n="nav.about">{navLabels.about}</a>
          <a href={`${navPrefix}/privacy/`} data-i18n="nav.privacy">{navLabels.privacy}</a>
          <a href={`${navPrefix}/terms/`} data-i18n="nav.terms">{navLabels.terms}</a>
          <a href={`${navPrefix}/contact/`} data-i18n="nav.contact">{navLabels.contact}</a>
        </div>
        <p class="footer-note" data-i18n="footer.note">
          {navLabels.footer}
        </p>
      </div>
    </footer>

    <script type="module" src="/scripts/lang-init.js"></script>
  </body>
</html>
