---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: object | object[];
  robots?: string;
  lang?: string;
  singleLang?: boolean;
  alternateLangs?: string[];
}

const {
  title,
  description,
  canonical = 'https://www.aicheck365.com',
  ogImage = 'https://www.aicheck365.com/og.png',
  jsonLd,
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  lang: langProp,
  singleLang = false,
  alternateLangs,
} = Astro.props;

const SITE_URL = 'https://www.aicheck365.com';
const SITE_NAME = 'AICheck365';
const SITE_DESCRIPTION = 'A browser-local AI image and video origin detector for C2PA, EXIF, XMP, PNG text chunks, MP4/MOV metadata, file-name clues, and video frame watermark signals.';
const DEFAULT_LANG = 'zh-CN';
const SUPPORTED_LANGS = ['zh-CN', 'zh-TW', 'en', 'ja', 'ko', 'de', 'fr', 'es', 'pt-BR'];
const LOCALIZED_TOOL_LANGS = new Set(['zh-CN', 'zh-TW', 'en', 'ja', 'ko', 'de']);
const META_DESCRIPTION_MAX_LENGTH = 170;
const META_DESCRIPTION_MIN_BOUNDARY = 50;
const SEO_KEYWORDS = [
